{
  "name": "@taizan/prisma-base",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "框架基础表 schema（8 个 Prisma 片段）+ 基础 TENANT_MODELS + 加密列注册表 + schema-sync / verify-schema CLI + 幂等 seed。表结构是全仓的对外契约，改动按破坏性变更对待。",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli/sync": {
      "types": "./dist/cli/sync.d.ts",
      "import": "./dist/cli/sync.js",
      "require": "./dist/cli/sync.cjs"
    },
    "./cli/verify": {
      "types": "./dist/cli/verify.d.ts",
      "import": "./dist/cli/verify.js",
      "require": "./dist/cli/verify.cjs"
    },
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "taizan-schema-sync": "./dist/cli/sync.js",
    "taizan-verify-schema": "./dist/cli/verify.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate --schema schema"
  },
  "dependencies": {
    "@taizan/contracts": "workspace:*",
    "@taizan/tenant-scope": "workspace:*"
  },
  "peerDependencies": {
    "prisma": "^6"
  },
  "peerDependenciesMeta": {
    "prisma": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@taizan/eslint-config": "workspace:*",
    "@taizan/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prisma": "^6.19.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
