{
  "name": "@taizan/nest-rbac",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "RBAC 执行层：权限点/菜单/功能项注册表（代码即真源）、@RequirePermission + PermissionsGuard、@DataScope() 拦截器、bootstrap 下发组装、注册表→DB 镜像同步与 taizan-rbac-sync 命令。所有判定与裁剪逻辑委托给 @taizan/rbac-core，本包只做 Nest 接线与 DB 同步。",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "bin": {
    "taizan-rbac-sync": "./dist/sync/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@taizan/contracts": "workspace:*",
    "@taizan/nest-auth": "workspace:*",
    "@taizan/nest-core": "workspace:*",
    "@taizan/nest-prisma": "workspace:*",
    "@taizan/rbac-core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@taizan/eslint-config": "workspace:*",
    "@taizan/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
