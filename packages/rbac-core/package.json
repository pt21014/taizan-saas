{
  "name": "@taizan/rbac-core",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "RBAC 纯函数内核：权限点表达式求值（'a|b' 或 / ['a','b'] 与）、角色展开与通配处理、菜单树按 权限 ∩ 套餐 features ∩ 显式禁用 裁剪、数据范围 buildScopeWhere。零框架依赖，仅依赖 @taizan/contracts，可在裸 node 环境跑单测。",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@taizan/contracts": "workspace:*"
  },
  "devDependencies": {
    "@taizan/eslint-config": "workspace:*",
    "@taizan/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
