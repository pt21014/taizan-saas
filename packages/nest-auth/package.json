{
  "name": "@taizan/nest-auth",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "三套身份认证：独立密钥的 JWT（platform / staff / member）+ kind 校验、全局 APP_GUARD 默认拒绝 + @Public()/@Auth(kind)、Redis 多会话按 jti 吊销与 refresh 轮换、staff 每请求现查成员关系（30s 缓存、库里角色覆盖 token）、租户解析链、图形验证码。",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run && node scripts/check-dist-identity.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@taizan/contracts": "workspace:*",
    "@taizan/nest-core": "workspace:*",
    "@taizan/nest-prisma": "workspace:*",
    "@taizan/ratelimit-core": "workspace:*",
    "jose": "^5.9.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@taizan/eslint-config": "workspace:*",
    "@taizan/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
