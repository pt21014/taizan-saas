{
  "name": "@taizan/app-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "两个 Expo App（apps/app-client、apps/app-merchant）共用的移动端基座层（蓝图 §5.4/T3-7）：design token（来自 @taizan/tokens 的 toRNTokens）、基础组件、最小图表、createApiClient（基于 @taizan/contracts 的 createEnvelopeClient）、SecureStore 会话、更新检查。以源码形式被 Metro 消费，没有 build 步骤，因此 exports/main/types 都直接指向 src。",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-secure-store": "*",
    "expo-updates": "*",
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "peerDependenciesMeta": {
    "expo-updates": {
      "optional": true
    }
  },
  "dependencies": {
    "@taizan/contracts": "workspace:*",
    "@taizan/tokens": "workspace:*"
  },
  "devDependencies": {
    "@taizan/eslint-config": "workspace:*",
    "@taizan/tsconfig": "workspace:*",
    "@types/react": "~19.2.2",
    "eslint": "^9.17.0",
    "react": "19.2.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
