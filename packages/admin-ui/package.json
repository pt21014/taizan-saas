{
  "name": "@taizan/admin-ui",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "apps/admin 与 apps/platform 共用的后台基座层（蓝图 §5.2）：request（基于 @taizan/contracts 的 createEnvelopeClient）、session（zustand，来自 /auth/bootstrap 的唯一真源）、布局与登录选店、只读闸门、服务端菜单渲染与权限路由（buildRoutes/renderMenus/RequirePermission/usePerm）、CRUD 层（useCrudTable/useCrudForm/CrudTable/CrudDrawerForm）、预签名直传上传组件。",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run && node scripts/check-dist-resolve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.0.0",
    "antd": "^5.0.0",
    "axios": "^1.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "dependencies": {
    "@taizan/contracts": "workspace:*",
    "@taizan/rbac-core": "workspace:*",
    "@taizan/tokens": "workspace:*"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@taizan/eslint-config": "workspace:*",
    "@taizan/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.29.3",
    "axios": "^1.20.0",
    "eslint": "^9.17.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^3.0.0",
    "zustand": "^5.0.15"
  }
}
