/* 本文件由 `pnpm -F {{scope}}/site dev|build` 自动生成（apps/site/scripts/generate-tokens.ts），
 * 源自 @taizan/tokens 的 toScssVariables()。不要手改——改 packages/tokens/src/*.ts
 * 里的色板/间距/字号后重新跑一次生成脚本即可同步。 */
:root {
  /* 本文件由 @taizan/tokens 的 toScssVariables() 生成，不要手改，改 palette.ts 等源文件后重新生成。 */

  /* 颜色 */
  --{{projectName}}-color-primary: #6366f1;
  --{{projectName}}-color-success: #16a34a;
  --{{projectName}}-color-warning: #f59e0b;
  --{{projectName}}-color-error: #dc2626;
  --{{projectName}}-color-info: #2563eb;
  --{{projectName}}-color-text: #1c1e21;
  --{{projectName}}-color-bg: #ffffff;

  /* 间距 */
  --{{projectName}}-spacing-none: 0px;
  --{{projectName}}-spacing-xs: 4px;
  --{{projectName}}-spacing-sm: 8px;
  --{{projectName}}-spacing-md: 12px;
  --{{projectName}}-spacing-lg: 16px;
  --{{projectName}}-spacing-xl: 24px;
  --{{projectName}}-spacing-xxl: 32px;
  --{{projectName}}-spacing-xxxl: 48px;

  /* 字号 */
  --{{projectName}}-font-family:
    -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --{{projectName}}-font-size-xs: 12px;
  --{{projectName}}-font-size-sm: 13px;
  --{{projectName}}-font-size-md: 14px;
  --{{projectName}}-font-size-lg: 16px;
  --{{projectName}}-font-size-xl: 20px;
  --{{projectName}}-font-size-xxl: 24px;

  /* 圆角 */
  --{{projectName}}-radius-none: 0px;
  --{{projectName}}-radius-sm: 2px;
  --{{projectName}}-radius-md: 6px;
  --{{projectName}}-radius-lg: 12px;
  --{{projectName}}-radius-full: 9999px;

  /* 阴影 */
  --{{projectName}}-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
  --{{projectName}}-shadow-md: 0 4px 8px rgba(0, 0, 0, 0.08);
  --{{projectName}}-shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.12);
}
