@import './tokens.css';

/**
 * 基础响应式样式。零 UI 库：这里只写布局骨架（容器、导航、网格、卡片、表单、按钮）
 * 与颜色/间距/字号取值——全部读 `tokens.css` 的 CSS 变量，不在这里另写一份色值。
 */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
}

body {
  margin: 0;
  font-family: var(--{{projectName}}-font-family);
  font-size: var(--{{projectName}}-font-size-md);
  line-height: 1.6;
  color: var(--{{projectName}}-color-text);
  background: var(--{{projectName}}-color-bg);
}

a {
  color: var(--{{projectName}}-color-primary);
  text-decoration: none;
}

img {
  max-width: 100%;
  display: block;
}

.container {
  width: 100%;
  max-width: 1120px;
  margin: 0 auto;
  padding: 0 var(--{{projectName}}-spacing-lg);
}

/* ---------- 顶部导航 ---------- */

.nav {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--{{projectName}}-color-bg);
  border-bottom: 1px solid #eef0f3;
}

.nav__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64px;
  gap: var(--{{projectName}}-spacing-lg);
}

.logo {
  display: flex;
  align-items: center;
  gap: var(--{{projectName}}-spacing-sm);
  font-weight: 700;
  font-size: var(--{{projectName}}-font-size-lg);
  color: var(--{{projectName}}-color-text);
}

.logo__mark {
  width: 22px;
  height: 22px;
  border-radius: var(--{{projectName}}-radius-sm);
  background: var(--{{projectName}}-color-primary);
}

.nav__links {
  display: flex;
  gap: var(--{{projectName}}-spacing-lg);
  flex-wrap: wrap;
}

.nav__links a {
  color: var(--{{projectName}}-color-text);
  font-size: var(--{{projectName}}-font-size-sm);
}

.nav__links a[data-on='1'] {
  color: var(--{{projectName}}-color-primary);
  font-weight: 600;
}

.nav__right {
  display: flex;
  align-items: center;
  gap: var(--{{projectName}}-spacing-sm);
}

.nav__toggle {
  display: none;
  border: none;
  background: transparent;
  font-size: 20px;
  cursor: pointer;
}

/* ---------- 按钮 ---------- */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--{{projectName}}-spacing-xs);
  padding: var(--{{projectName}}-spacing-sm) var(--{{projectName}}-spacing-lg);
  border-radius: var(--{{projectName}}-radius-md);
  border: 1px solid transparent;
  font-size: var(--{{projectName}}-font-size-sm);
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.15s ease;
}

.btn:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

.btn--primary {
  background: var(--{{projectName}}-color-primary);
  color: #fff;
}

.btn--ghost {
  background: transparent;
  border-color: #dcdfe6;
  color: var(--{{projectName}}-color-text);
}

.btn--lg {
  padding: var(--{{projectName}}-spacing-md) var(--{{projectName}}-spacing-xl);
  font-size: var(--{{projectName}}-font-size-lg);
}

.btn--block {
  width: 100%;
}

/* ---------- 通用区块 ---------- */

.section {
  padding: var(--{{projectName}}-spacing-xxxl) 0;
}

.section--tint {
  background: #f7f8fc;
}

.section__head {
  text-align: center;
  max-width: 640px;
  margin: 0 auto var(--{{projectName}}-spacing-xxl);
}

.section__head h2 {
  font-size: var(--{{projectName}}-font-size-xxl);
}

.section__head p {
  color: #6b7078;
}

.grid {
  display: grid;
  gap: var(--{{projectName}}-spacing-lg);
}

.grid--2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid--3 {
  grid-template-columns: repeat(3, 1fr);
}

.card {
  background: #fff;
  border: 1px solid #eef0f3;
  border-radius: var(--{{projectName}}-radius-lg);
  padding: var(--{{projectName}}-spacing-lg);
  box-shadow: var(--{{projectName}}-shadow-sm);
}

.card--pad-lg {
  padding: var(--{{projectName}}-spacing-xxl);
}

.split {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: var(--{{projectName}}-spacing-xxl);
}

/* ---------- 套餐价格 ---------- */

.plans {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: var(--{{projectName}}-spacing-lg);
}

.plan {
  position: relative;
  border: 1px solid #eef0f3;
  border-radius: var(--{{projectName}}-radius-lg);
  padding: var(--{{projectName}}-spacing-xl);
  display: flex;
  flex-direction: column;
  gap: var(--{{projectName}}-spacing-md);
}

.plan--hot {
  border-color: var(--{{projectName}}-color-primary);
  box-shadow: var(--{{projectName}}-shadow-md);
}

.plan__tag {
  position: absolute;
  top: -12px;
  left: var(--{{projectName}}-spacing-lg);
  background: var(--{{projectName}}-color-primary);
  color: #fff;
  font-size: var(--{{projectName}}-font-size-xs);
  padding: 2px var(--{{projectName}}-spacing-sm);
  border-radius: var(--{{projectName}}-radius-full);
}

.plan__price b {
  font-size: 32px;
}

.plan__price span {
  color: #6b7078;
  font-size: var(--{{projectName}}-font-size-sm);
}

.list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: var(--{{projectName}}-spacing-xs);
  font-size: var(--{{projectName}}-font-size-sm);
  color: #4d5158;
}

/* ---------- 表单 ---------- */

.form {
  display: grid;
  gap: var(--{{projectName}}-spacing-lg);
}

.field label {
  display: block;
  font-size: var(--{{projectName}}-font-size-sm);
  font-weight: 600;
  margin-bottom: var(--{{projectName}}-spacing-xs);
}

.field input {
  width: 100%;
  padding: var(--{{projectName}}-spacing-sm) var(--{{projectName}}-spacing-md);
  border: 1px solid #dcdfe6;
  border-radius: var(--{{projectName}}-radius-md);
  font-size: var(--{{projectName}}-font-size-md);
}

.field input[aria-invalid='true'] {
  border-color: var(--{{projectName}}-color-error);
}

.field__hint {
  margin-top: var(--{{projectName}}-spacing-xs);
  font-size: var(--{{projectName}}-font-size-xs);
  color: #8a8f98;
}

.field__hint--bad {
  color: var(--{{projectName}}-color-error);
}

.field__hint--ok {
  color: var(--{{projectName}}-color-success);
}

.check {
  display: flex;
  align-items: flex-start;
  gap: var(--{{projectName}}-spacing-sm);
  font-size: var(--{{projectName}}-font-size-sm);
}

.notice {
  padding: var(--{{projectName}}-spacing-md);
  border-radius: var(--{{projectName}}-radius-md);
  font-size: var(--{{projectName}}-font-size-sm);
}

.notice--info {
  background: #e6f1ff;
  color: #1d4ed8;
}

.notice--bad {
  background: #feecec;
  color: var(--{{projectName}}-color-error);
}

.notice--ok {
  background: #e6f7ed;
  color: var(--{{projectName}}-color-success);
}

.captcha {
  display: flex;
  align-items: center;
  gap: var(--{{projectName}}-spacing-sm);
}

.captcha img {
  border-radius: var(--{{projectName}}-radius-sm);
  border: 1px solid #eef0f3;
  cursor: pointer;
}

/* ---------- 页脚 ---------- */

.footer {
  background: #16181d;
  color: #c7c9cf;
  padding: var(--{{projectName}}-spacing-xxxl) 0 var(--{{projectName}}-spacing-xl);
  margin-top: var(--{{projectName}}-spacing-xxxl);
}

.footer .logo {
  color: #fff;
}

.footer__grid {
  display: grid;
  grid-template-columns: 1.4fr repeat(3, 1fr);
  gap: var(--{{projectName}}-spacing-xl);
}

.footer h5 {
  color: #fff;
  font-size: var(--{{projectName}}-font-size-sm);
  margin-bottom: var(--{{projectName}}-spacing-sm);
}

.footer ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: var(--{{projectName}}-spacing-xs);
}

.footer a {
  color: #c7c9cf;
}

.footer__bottom {
  margin-top: var(--{{projectName}}-spacing-xxl);
  padding-top: var(--{{projectName}}-spacing-lg);
  border-top: 1px solid #2a2d34;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--{{projectName}}-spacing-sm);
  font-size: var(--{{projectName}}-font-size-xs);
}

/* ---------- 响应式 ---------- */

@media (max-width: 860px) {
  .split {
    grid-template-columns: 1fr;
  }

  .grid--2,
  .grid--3 {
    grid-template-columns: 1fr;
  }

  .footer__grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 640px) {
  .nav__links {
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    background: var(--{{projectName}}-color-bg);
    border-bottom: 1px solid #eef0f3;
    flex-direction: column;
    padding: var(--{{projectName}}-spacing-md) var(--{{projectName}}-spacing-lg);
    display: none;
  }

  .nav__links[data-open='1'] {
    display: flex;
  }

  .nav__toggle {
    display: block;
  }

  .footer__grid {
    grid-template-columns: 1fr;
  }
}
