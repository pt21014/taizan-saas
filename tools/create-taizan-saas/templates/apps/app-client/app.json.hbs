{
  "expo": {
    "name": "台账门店",
    "slug": "{{projectName}}-app-client",
    "scheme": "{{projectSlug}}client",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vip.{{projectSlug}}.app.client"
    },
    "android": {
      "package": "vip.{{projectSlug}}.app.client"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiBase": "http://localhost:3000/api",
      "tenantSlug": "demo"
    }
  }
}
