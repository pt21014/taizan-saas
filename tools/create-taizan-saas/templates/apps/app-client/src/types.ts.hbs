/** `POST /api/client/auth/login-dev` 的响应（`apps/api/src/modules/client/auth/client-auth.service.ts`）。 */
export interface ClientLoginResult {
  access: string
  refresh: string
  expiresIn: number
  member: { id: string; phone: string | null; nickname: string | null }
  tenantId: string
}

/** `GET /api/client/{{domainSlug}}` 单条（`apps/api/src/modules/example-{{domainSlug}}/dto/{{domainSlug}}.dto.ts`）。 */
export interface {{DomainPascal}}View {
  id: string
  name: string
  priceCents: number
  stock: number
  status: 'DRAFT' | 'ON_SHELF' | 'OFF_SHELF'
  createdAt: string
  updatedAt: string
}
