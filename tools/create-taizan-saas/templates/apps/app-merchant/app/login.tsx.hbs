import { Button, Card, colors, spacing, textVariants, toast } from '@taizan/app-ui'
import { router } from 'expo-router'
import { useState } from 'react'
import { Text, TextInput, View } from 'react-native'

import { api } from '../src/api'
import { bootstrapAndSave } from '../src/bootstrap'
import { setPendingLogin } from '../src/pendingLogin'
import type { AdminLoginResult } from '../src/types'

/** `POST /api/admin/auth/login`：手机号 + 口令；名下多店时不签 token，转去选店页。 */
export default function LoginScreen() {
  const [phone, setPhone] = useState('')
  const [password, setPassword] = useState('')
  const [loading, setLoading] = useState(false)

  async function submit() {
    if (!/^1[3-9]\d{9}$/.test(phone)) {
      toast.show('请输入正确的手机号', 'error')
      return
    }
    if (!password) {
      toast.show('请输入口令', 'error')
      return
    }
    setLoading(true)
    try {
      const result = await api.post<AdminLoginResult>('/admin/auth/login', { phone, password })
      if (result.needChooseShop) {
        setPendingLogin({ phone, password })
        router.push({ pathname: '/shop-chooser', params: { shops: JSON.stringify(result.shops) } })
        return
      }
      await bootstrapAndSave(result.access)
      router.replace('/dashboard')
    } catch {
      // createApiClient 已经把「手机号或密码不正确」toast 出来了。
    } finally {
      setLoading(false)
    }
  }

  return (
    <View
      style=\{{
        flex: 1,
        backgroundColor: colors.bgBase,
        padding: spacing.xl,
        justifyContent: 'center',
      }}
    >
      <Text
        style=\{{
          fontSize: textVariants.title.fontSize,
          fontWeight: '700',
          marginBottom: spacing.xl,
        }}
      >
        商家登录
      </Text>
      <Card padded>
        <Text style=\{{ fontSize: textVariants.sub.fontSize, color: colors.gray[500] ?? '#999' }}>
          手机号
        </Text>
        <TextInput
          value={phone}
          onChangeText={setPhone}
          placeholder="请输入手机号"
          keyboardType="phone-pad"
          maxLength={11}
          style={inputStyle}
        />
        <Text
          style=\{{
            fontSize: textVariants.sub.fontSize,
            color: colors.gray[500] ?? '#999',
            marginTop: spacing.md,
          }}
        >
          口令
        </Text>
        <TextInput
          value={password}
          onChangeText={setPassword}
          placeholder="请输入口令"
          secureTextEntry
          style={inputStyle}
        />
        <Button
          title="登录"
          onPress={() => void submit()}
          loading={loading}
          style=\{{ marginTop: spacing.lg }}
        />
      </Card>
    </View>
  )
}

const inputStyle = {
  borderWidth: 1,
  borderColor: colors.gray[300] ?? '#ccc',
  borderRadius: 8,
  paddingHorizontal: spacing.md,
  paddingVertical: 10,
  fontSize: textVariants.body.fontSize,
  marginTop: spacing.sm,
}
