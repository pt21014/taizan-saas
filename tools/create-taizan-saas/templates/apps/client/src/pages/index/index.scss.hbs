.{{domainSlug}}-list {
  padding: 24px;

  &__empty {
    padding: 80px 0;
    text-align: center;
    color: #999;
  }

  &__login-tip {
    padding: 60px 0;
    text-align: center;
    color: #666;
  }
}

.{{domainSlug}}-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px;
  margin-bottom: 16px;
  background: #fff;
  border-radius: 12px;

  &__name {
    font-size: 30px;
    color: #333;
  }

  &__price {
    font-size: 30px;
    color: #ff4d4f;
    font-weight: 600;
  }
}

.login-btn {
  margin-top: 24px;
}
