async function countAudit(targetId: string, action: string): Promise<number> {
  return prisma.auditLog.count({ where: { targetId, action } })
}

/** 轮询等待一个条件成立（审计是旁路写入，不保证在响应返回时已经落库）。 */
async function waitFor(check: () => Promise<boolean>, timeoutMs = 5000): Promise<void> {
  const deadline = Date.now() + timeoutMs
  for (;;) {
    if (await check()) return
    if (Date.now() > deadline) throw new Error(`等待超时（${timeoutMs}ms）`)
    await new Promise((resolve) => setTimeout(resolve, 100))
  }
}
