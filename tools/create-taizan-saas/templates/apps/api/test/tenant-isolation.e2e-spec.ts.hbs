/** 每次跑用一段唯一后缀，两家店互不干扰、重复跑也不打架。 */
const RUN = ulid().slice(-8).toLowerCase()

const SHOP_A = { slug: `e2e-a-${RUN}`, name: `E2E A ${RUN}`, phone: phoneFor(1) }
const SHOP_B = { slug: `e2e-b-${RUN}`, name: `E2E B ${RUN}`, phone: phoneFor(2) }
const MEMBER_PHONE = phoneFor(3)
const OWNER_PASSWORD = 'e2e-password-123'

/**
 * 本文件的登录请求专用的「客户端 IP」（起法与 `plan-order.e2e-spec.ts` 一致）。
 *
 * `login` 档限流按**客户端 IP** 计（5 分钟 10 次），而 e2e 每个文件都从 `127.0.0.1`
 * 打过来、又串行跑（`fileParallelism: false`），几个文件共用同一个桶。本文件一趟要登
 * 5 次（平台 3 次 + 店主 2 次），和别的文件加起来就会超——后面的文件拿到 `1042900`
 * 而不是它想断言的东西，失败信息看起来像「登录逻辑坏了」。
 *
 * `TRUSTED_PROXY_HOPS=1` + `X-Forwarded-For` 让本文件的登录落进自己的桶。
 * 这不是绕过限流：限流本身由 `test/ratelimit.e2e-spec.ts` 专门验证。
 */
const LOGIN_IP = `10.97.${([...RUN].reduce((a, c) => (a + c.charCodeAt(0)) % 200, 11) + 1).toString()}.5`

/** 本文件所有登录请求的统一起手式：一定带上 {@link LOGIN_IP}。 */
function loginRequest(url: string) {
  return request(http()).post(url).set('X-Forwarded-For', LOGIN_IP)
}

/** 造一个本次运行专用的手机号（全局唯一键，不能和 seed 的演示账号撞）。 */
function phoneFor(n: number): string {
  // 139 + 8 位：用运行后缀的数字化结果，保证同一次运行内稳定、不同运行间几乎不撞。
  const digits = [...RUN]
    .map((c) => c.charCodeAt(0) % 10)
    .join('')
    .slice(0, 7)
  return `139${digits}${n}`
}

let app: INestApplication
let prisma: PrismaClient

/** supertest 的目标（`getHttpServer()` 回的是 `any`，这里收窄成 supertest 认的形状）。 */
function http(): Parameters<typeof request>[0] {
  return app.getHttpServer() as Parameters<typeof request>[0]
}

/** 成功响应的信封形状；`code` 不为 0 时直接把整个 body 打出来，省得反复加日志。 */
function expectOk<T>(body: unknown): T {
  const envelope = body as { code: number; message: string; data: T }
  expect(envelope.code, `期望 code=0，实际：${JSON.stringify(envelope)}`).toBe(0)
  return envelope.data
}

/** 取业务码。 */
function codeOf(body: unknown): number {
  return (body as { code: number }).code
}

interface Shop {
  tenantId: string
  slug: string
  token: string
  staffId: string
}

/** 平台超管 token。 */
let platformToken = ''
let shopA: Shop
let shopB: Shop
/** A 店的三个商品 id。 */
let {{domainSlug}}A: string[] = []
/** B 店的两个商品 id。 */
let {{domainSlug}}B: string[] = []

/** 用平台 token 开一家店，然后用店主账号登录，返回 staff token。 */
async function createShopAndLogin(spec: {
  slug: string
  name: string
  phone: string
}): Promise<Shop> {
  const created = await request(http())
    .post('/api/platform/tenants')
    .set('Authorization', `Bearer ${platformToken}`)
    .send({
      slug: spec.slug,
      name: spec.name,
      ownerPhone: spec.phone,
      ownerPassword: OWNER_PASSWORD,
      trialDays: 30,
    })
  const data = expectOk<{ tenant: { id: string; slug: string } }>(created.body)

  const login = await loginRequest('/api/admin/auth/login').send({
    phone: spec.phone,
    password: OWNER_PASSWORD,
    tenantId: data.tenant.id,
  })
  const session = expectOk<{ needChooseShop: boolean; access: string; staffId: string }>(login.body)
  expect(session.needChooseShop).toBe(false)

  return {
    tenantId: data.tenant.id,
    slug: data.tenant.slug,
    token: session.access,
    staffId: session.staffId,
  }
}

/** 用某家店的 token 建一个商品，返回 id。 */
async function create{{DomainPascal}}(shop: Shop, name: string, priceCents = 100): Promise<string> {
  const res = await request(http())
    .post('/api/admin/{{domainSlug}}')
    .set('Authorization', `Bearer ${shop.token}`)
    .send({ name, priceCents, stock: 5, status: 'ON_SHELF' })
  return expectOk<{ {{domainSlug}}: { id: string } }>(res.body).{{domainSlug}}.id
}

/** 造一个带租户的执行上下文（给「直接调 service」的用例用）。 */
function tenantContext(tenantId: string): RequestContext {
  return {
    traceId: ulid(),
    tenantId,
    ip: { client: '127.0.0.1', edge: '127.0.0.1' },
    startedAt: Date.now(),
  }
}

beforeAll(async () => {
  prisma = new PrismaClient()

  // 保证平台管理员与套餐存在。`withDemoTenant: false`：本文件自己建两家店，
  // 不依赖也不污染 `pnpm seed` 造的 demo / demo-b。seedBase 是幂等的，重复跑没事。
  await seedBase(
    {
      platformAdmin: prisma.platformAdmin,
      plan: prisma.plan,
      tenant: prisma.tenant,
      staffAccount: prisma.staffAccount,
      staff: findFirstUpsertDelegate(prisma.staff),
      role: findFirstUpsertDelegate(prisma.role),
      rolePreset: prisma.rolePreset,
    },
    { withDemoTenant: false },
  )

  const moduleRef = await Test.createTestingModule({ imports: [AppModule] }).compile()
  app = moduleRef.createNestApplication({ logger: false })
  // 与 `main.ts` 调的是同一段配置——否则这套 e2e 测的是另一个 app。
  configureApp(app)
  await app.init()
})

afterAll(async () => {
  await app?.close()
  await prisma?.$disconnect()
})

