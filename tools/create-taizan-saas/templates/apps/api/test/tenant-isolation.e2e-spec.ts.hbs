describe('① 平台登录', () => {
  it('用户名 + 口令登录成功，拿到 platform token', async () => {
    const res = await loginRequest('/api/platform/auth/login')
      .send({ username: 'admin', password: 'admin123' })
      .expect(201)
    const data = expectOk<{ access: string; admin: { username: string } }>(res.body)
    expect(data.admin.username).toBe('admin')
    platformToken = data.access
  })

  it('口令不对 → 1140100，且文案不区分「用户名不存在」与「口令错」', async () => {
    const res = await loginRequest('/api/platform/auth/login').send({
      username: 'admin',
      password: 'wrong-password',
    })
    expect(codeOf(res.body)).toBe(1140100)

    const missing = await loginRequest('/api/platform/auth/login').send({
      username: 'no-such-admin',
      password: 'whatever',
    })
    // 两条文案必须一样——不一样就是一个用户名枚举器。
    expect((missing.body as { message: string }).message).toBe(
      (res.body as { message: string }).message,
    )
  })

  it('platform token 打 /api/admin → 1140102（凭证类型不符，不是 1240400）', async () => {
    const res = await request(http())
      .get('/api/admin/{{domainSlug}}')
      .set('Authorization', `Bearer ${platformToken}`)
    expect(codeOf(res.body)).toBe(1140102)
  })
})

describe('② 建租户 A、B', () => {
  it('平台后台开出两家店', async () => {
    shopA = await createShopAndLogin(SHOP_A)
    shopB = await createShopAndLogin(SHOP_B)
    expect(shopA.tenantId).not.toBe(shopB.tenantId)
  })

  it('slug 重复被拒（全局唯一且不可改）', async () => {
    const res = await request(http())
      .post('/api/platform/tenants')
      .set('Authorization', `Bearer ${platformToken}`)
      .send({ slug: SHOP_A.slug, name: '想抢 slug 的店', ownerPhone: phoneFor(9) })
    expect(codeOf(res.body)).toBe(1040000)
  })

  it('无 token 打平台接口 → 1140100（平台面也默认拒绝）', async () => {
    const res = await request(http()).get('/api/platform/tenants')
    expect(codeOf(res.body)).toBe(1140100)
  })
})

describe('③ 两个店主各自登录', () => {
  it('两张 token 绑定不同的店', async () => {
    expect(shopA.token).not.toBe(shopB.token)
    expect(shopA.staffId).not.toBe(shopB.staffId)
  })

  it('bootstrap 回来的当前店与 token 一致，且店主拿到全部权限点', async () => {
    const res = await request(http())
      .get('/api/admin/auth/bootstrap')
      .set('Authorization', `Bearer ${shopA.token}`)
      .expect(200)
    const data = expectOk<{
      identity: { isOwner: boolean }
      tenant: { id: string; slug: string }
      shops: { tenantId: string }[]
      permissions: string[]
      menus: { key: string }[]
    }>(res.body)

    expect(data.tenant.id).toBe(shopA.tenantId)
    expect(data.tenant.slug).toBe(SHOP_A.slug)
    expect(data.identity.isOwner).toBe(true)
    // 店主 = 全部已注册权限点（`expandRoles({ ownerAll: true })`）。
    expect(data.permissions).toContain('{{domainSlug}}:list')
    expect(data.permissions).toContain('{{domainSlug}}:delete')
    // 菜单已按权限 ∩ 套餐裁剪；店主什么都看得到。
    expect(data.menus.map((m) => m.key)).toContain('{{domainSlug}}')
    // 一号多店的切换列表里**只有自己名下的店**，绝不该出现 B 店。
    expect(data.shops.map((s) => s.tenantId)).toEqual([shopA.tenantId])
  })
})

describe('④⑤ 各自建商品，列表只见自己的', () => {
  it('A 建 3 个，B 建 2 个', async () => {
    {{domainSlug}}A = [
      await create{{DomainPascal}}(shopA, 'A-可乐', 300),
      await create{{DomainPascal}}(shopA, 'A-雪碧', 300),
      await create{{DomainPascal}}(shopA, 'A-咖啡', 1500),
    ]
    {{domainSlug}}B = [await create{{DomainPascal}}(shopB, 'B-可乐', 400), await create{{DomainPascal}}(shopB, 'B-茶', 800)]
    expect(new Set([...{{domainSlug}}A, ...{{domainSlug}}B]).size).toBe(5)
  })

  it('两家店可以有同名商品（唯一索引是 [tenantId, name, deletedAt]）', async () => {
    const id = await create{{DomainPascal}}(shopB, 'A-可乐', 999)
    {{domainSlug}}B.push(id)
    expect(id).toBeTruthy()
  })

  it('同一家店内不允许重名', async () => {
    const res = await request(http())
      .post('/api/admin/{{domainSlug}}')
      .set('Authorization', `Bearer ${shopA.token}`)
      .send({ name: 'A-可乐', priceCents: 100 })
    expect(codeOf(res.body)).toBe(1040000)
  })

  it('⑤ A 的 token 列出商品：只有 A 的 3 个', async () => {
    const res = await request(http())
      .get('/api/admin/{{domainSlug}}')
      .set('Authorization', `Bearer ${shopA.token}`)
      .expect(200)
    const page = expectOk<{ items: { id: string; name: string }[]; total: number }>(res.body)
    expect(page.total).toBe(3)
    expect(page.items.map((i) => i.id).sort()).toEqual([...{{domainSlug}}A].sort())
    expect(page.items.every((i) => i.name.startsWith('A-'))).toBe(true)
  })

  it('⑤ B 的 token 列出商品：只有 B 的 3 个', async () => {
    const res = await request(http())
      .get('/api/admin/{{domainSlug}}')
      .set('Authorization', `Bearer ${shopB.token}`)
      .expect(200)
    const page = expectOk<{ items: { id: string }[]; total: number }>(res.body)
    expect(page.total).toBe(3)
    expect(page.items.map((i) => i.id).sort()).toEqual([...{{domainSlug}}B].sort())
  })

  it('响应里不含 tenantId（那是服务端的实现细节）', async () => {
    const res = await request(http())
      .get('/api/admin/{{domainSlug}}')
      .set('Authorization', `Bearer ${shopA.token}`)
    expect(JSON.stringify(res.body)).not.toContain(shopA.tenantId)
  })
})

describe('⑥ 拿别家的商品 id 增删改查 → 1240300', () => {
  /**
   * 为什么统一是 1240300 而不是「GET 404 / DELETE 403」：
   *
   * `@taizan/tenant-scope` 对两类操作的处理天然不同——`findUnique` 走
   * `checkResultOwner` 且 `throwWhenForeign: false`（返回 `null`，看起来像「不存在」），
   * `update`/`delete` 走 `verifyOwnerThenExecute`（探针发现归属不符，抛 `FOREIGN_RESULT`）。
   *
   * `{{DomainPascal}}Service.requireOwned` 主动把读路径也收敛成 1240300：
   * 不区分「不存在」与「是别人的」**正是安全上想要的**——区分了就等于提供一个
   * 「这个 id 在不在别人家」的存在性探测器。前端也只需要处理一个码。
   */
  const foreign = (): string => {{domainSlug}}B[0] as string

  it('GET 别家的商品 → 1240300', async () => {
    const res = await request(http())
      .get(`/api/admin/{{domainSlug}}/${foreign()}`)
      .set('Authorization', `Bearer ${shopA.token}`)
    expect(codeOf(res.body)).toBe(1240300)
  })

  it('PUT 别家的商品 → 1240300，且**没有改到那条记录**', async () => {
    const before = await prisma.{{domainSlug}}.findUnique({ where: { id: foreign() } })
    const res = await request(http())
      .put(`/api/admin/{{domainSlug}}/${foreign()}`)
      .set('Authorization', `Bearer ${shopA.token}`)
      .send({ priceCents: 1 })
    expect(codeOf(res.body)).toBe(1240300)

    const after = await prisma.{{domainSlug}}.findUnique({ where: { id: foreign() } })
    expect(after?.priceCents).toBe(before?.priceCents)
  })

  it('DELETE 别家的商品 → 1240300，且**没有软删掉那条记录**', async () => {
    const res = await request(http())
      .delete(`/api/admin/{{domainSlug}}/${foreign()}`)
      .set('Authorization', `Bearer ${shopA.token}`)
    expect(codeOf(res.body)).toBe(1240300)

    const row = await prisma.{{domainSlug}}.findUnique({ where: { id: foreign() } })
    expect(row?.deletedAt).toBeNull()
  })

  it('不存在的 id 也是 1240300（不给存在性探测器）', async () => {
    const res = await request(http())
      .get(`/api/admin/{{domainSlug}}/${ulid()}`)
      .set('Authorization', `Bearer ${shopA.token}`)
    expect(codeOf(res.body)).toBe(1240300)
  })
})

describe('⑦ 请求里携带别家的 tenantId 不改变任何结果', () => {
  it('query / body / 自定义头里塞 B 的 tenantId，A 仍然只看得见自己的 3 个', async () => {
    const res = await request(http())
      .get(`/api/admin/{{domainSlug}}?tenantId=${shopB.tenantId}&tenant_id=${shopB.tenantId}`)
      .set('Authorization', `Bearer ${shopA.token}`)
      .set('X-Tenant-Id', shopB.tenantId)
      .set('X-Tenant-Slug', SHOP_B.slug)
      .expect(200)
    const page = expectOk<{ items: { id: string }[]; total: number }>(res.body)
    expect(page.total).toBe(3)
    expect(page.items.map((i) => i.id).sort()).toEqual([...{{domainSlug}}A].sort())
  })

  it('建商品时在 body 里塞 tenantId 也不会落到别家（多余字段被 DTO 丢掉）', async () => {
    const res = await request(http())
      .post('/api/admin/{{domainSlug}}')
      .set('Authorization', `Bearer ${shopA.token}`)
      .send({ name: `A-越权尝试-${RUN}`, priceCents: 100, tenantId: shopB.tenantId })
    const created = expectOk<{ {{domainSlug}}: { id: string } }>(res.body)
    {{domainSlug}}A.push(created.{{domainSlug}}.id)

    const row = await prisma.{{domainSlug}}.findUnique({ where: { id: created.{{domainSlug}}.id } })
    expect(row?.tenantId).toBe(shopA.tenantId)
  })

  it('X-Tenant-Slug 在 /api/admin 下完全不作数（那条前缀只认 token）', async () => {
    const res = await request(http()).get('/api/admin/{{domainSlug}}').set('X-Tenant-Slug', SHOP_A.slug)
    // 没 token 就是没登录，不管头里写了哪家店。
    expect(codeOf(res.body)).toBe(1140100)
  })
})

describe('⑧ 无 token / 坏 token 访问 /api/admin → 1140100', () => {
  /**
   * 这条就是 T0-8 里 nest-auth 那处修复的验收。
   *
   * 修之前：租户中间件跑在守卫**之前**，`/api/admin/*` 没 token 时三条解析策略全不适用，
   * 中间件失败关闭抛 `1240400`（租户不存在）——前端于是提示「店铺不存在」而不是跳登录页。
   *
   * 修之后：`/api/admin` 进 `TENANT_TOKEN_ONLY_PREFIXES`，中间件只跑 token 策略且
   * 解析不到时留空放行，由 `GlobalAuthGuard` 给出准确的 `1140100`。
   */
  it.each([
    ['无 Authorization 头', undefined],
    ['伪造的 token', 'Bearer eyJhbGciOiJIUzI1NiJ9.eyJraW5kIjoic3RhZmYifQ.forged'],
    ['不带 Bearer 前缀', 'some-raw-token'],
  ])('%s → 1140100', async (_label, authorization) => {
    const req = request(http()).get('/api/admin/{{domainSlug}}')
    if (authorization) req.set('Authorization', authorization)
    const res = await req
    expect(codeOf(res.body)).toBe(1140100)
    expect(codeOf(res.body)).not.toBe(1240400)
  })

  it('/api/client 仍然失败关闭：没线索就是 1240400', async () => {
    const res = await request(http()).get('/api/client/{{domainSlug}}')
    // C 端在登录前本来就靠 slug 选店，解析不出来就是真的「这家店不存在」。
    expect(codeOf(res.body)).toBe(1240400)
  })

  it('/api/public 免登录免租户，照常 200', async () => {
    const res = await request(http()).get('/api/public/health-echo').expect(200)
    const data = expectOk<{ tenantId: string | null; identityKind: string | null }>(res.body)
    expect(data.tenantId).toBeNull()
    expect(data.identityKind).toBeNull()
  })
})

describe('⑨ C 端会员的隔离', () => {
  let memberToken = ''

  it('会员在 A 店登录（X-Tenant-Slug 选店）', async () => {
    const res = await request(http())
      .post('/api/client/auth/login-dev')
      .set('X-Tenant-Slug', SHOP_A.slug)
      .send({ phone: MEMBER_PHONE })
      .expect(201)
    const data = expectOk<{ access: string; tenantId: string }>(res.body)
    expect(data.tenantId).toBe(shopA.tenantId)
    memberToken = data.access
  })

  it('会员只看得到 A 店已上架的商品', async () => {
    const res = await request(http())
      .get('/api/client/{{domainSlug}}')
      .set('Authorization', `Bearer ${memberToken}`)
      .set('X-Tenant-Slug', SHOP_A.slug)
      .expect(200)
    const page = expectOk<{ items: { name: string }[] }>(res.body)
    expect(page.items.length).toBeGreaterThan(0)
    expect(page.items.every((i) => i.name.startsWith('A-'))).toBe(true)
  })

  it('把 slug 头换成 B 店也不生效——token 里的租户压过请求头', async () => {
    const res = await request(http())
      .get('/api/client/{{domainSlug}}')
      .set('Authorization', `Bearer ${memberToken}`)
      .set('X-Tenant-Slug', SHOP_B.slug)
      .expect(200)
    const page = expectOk<{ items: { name: string }[] }>(res.body)
    // TokenTenantResolver 排在解析链首位，它一命中，SlugHeaderResolver 根本不会被调用。
    expect(page.items.every((i) => i.name.startsWith('A-'))).toBe(true)
  })

  it('member token 打商家后台 → 1140102', async () => {
    const res = await request(http())
      .get('/api/admin/{{domainSlug}}')
      .set('Authorization', `Bearer ${memberToken}`)
    expect(codeOf(res.body)).toBe(1140102)
  })

  it('staff token 打 C 端 → 1140102', async () => {
    const res = await request(http())
      .get('/api/client/{{domainSlug}}')
      .set('Authorization', `Bearer ${shopA.token}`)
    expect(codeOf(res.body)).toBe(1140102)
  })
})

describe('⑩ 软删：列表不见，但库里那行还在', () => {
  let victim = ''

  it('DELETE 之后列表少一个', async () => {
    victim = await create{{DomainPascal}}(shopA, `A-待删-${RUN}`)
    const before = expectOk<{ total: number }>(
      (await request(http()).get('/api/admin/{{domainSlug}}').set('Authorization', `Bearer ${shopA.token}`))
        .body,
    ).total

    await request(http())
      .delete(`/api/admin/{{domainSlug}}/${victim}`)
      .set('Authorization', `Bearer ${shopA.token}`)
      .expect(200)

    const after = expectOk<{ total: number }>(
      (await request(http()).get('/api/admin/{{domainSlug}}').set('Authorization', `Bearer ${shopA.token}`))
        .body,
    ).total
    expect(after).toBe(before - 1)
  })

  it('库里那行还在，deletedAt 非空（软删是软的，不是物理删）', async () => {
    // 用**未叠加任何扩展**的原始客户端查——`prisma.tenant` 会把软删的过滤掉，
    // 那样这条断言就永远看不到证据。
    const row = await prisma.{{domainSlug}}.findUnique({ where: { id: victim } })
    expect(row, '记录被物理删除了！软删扩展没接上写路径').not.toBeNull()
    expect(row?.deletedAt).not.toBeNull()
    expect(row?.tenantId).toBe(shopA.tenantId)
  })

  it('软删之后可以重新建一个同名商品（唯一索引带 deletedAt 的用处）', async () => {
    const again = await create{{DomainPascal}}(shopA, `A-待删-${RUN}`)
    {{domainSlug}}A.push(again)
    expect(again).not.toBe(victim)
  })
})

describe('⑪ 事务内软删：回滚必须把软删一起回滚', () => {
  /**
   * ## T0-6 标注的隐患，这条用例专门验它
   *
   * 软删扩展**改不了操作名**（Prisma 的 query 扩展没这个能力），所以 `delete` 分支
   * 不调 `query()`，而是拿「本扩展被 `$extends` 到的那个客户端」重新发一次 `update`
   * （`defineClientBoundQueryExtension`）。
   *
   * 隐患在于那个客户端引用是**在 `$extends` 时捕获的**。如果 Prisma 在
   * `$transaction()` 里不重新构造扩展（而是复用同一个闭包），那么事务内 `delete`
   * 改写出来的 `update` 会发到**事务外**的连接上——于是事务回滚了，软删却留下了。
   * 那是一种最难查的数据不一致：业务逻辑失败了，可商品已经不见了。
   *
   * 断言方式：在一个 `$transaction` 里删商品，然后**故意抛错**让事务回滚，
   * 最后用原始客户端确认那一行的 `deletedAt` 仍然是 `null`。
   */
  it('事务里删了商品然后抛错 → 商品未被软删', async () => {
    const id = await create{{DomainPascal}}(shopA, `A-事务-${RUN}`)
    {{domainSlug}}A.push(id)

    const {{domainSlug}} = app.get({{DomainPascal}}Service)
    const boom = new Error('故意抛错，让事务回滚')

    await expect(
      runWithContext(tenantContext(shopA.tenantId), async () =>
        {{domainSlug}}.removeInTransaction(id, async () => {
          throw boom
        }),
      ),
    ).rejects.toThrow('故意抛错')

    const row = await prisma.{{domainSlug}}.findUnique({ where: { id } })
    expect(
      row?.deletedAt,
      '事务回滚了但商品仍然被软删——说明软删改写出来的 update 脱离了事务，' +
        '需要改 @taizan/nest-prisma 的 createSoftDeleteExtension（用 Prisma.getExtensionContext 拿当前上下文）',
    ).toBeNull()
  })

  it('同一条路径不抛错时，事务提交，软删生效（证明上一条不是「压根没删」）', async () => {
    const id = await create{{DomainPascal}}(shopA, `A-事务提交-${RUN}`)

    const {{domainSlug}} = app.get({{DomainPascal}}Service)
    await runWithContext(tenantContext(shopA.tenantId), async () =>
      {{domainSlug}}.removeInTransaction(id, async () => {
        // 什么都不做，事务正常提交。
      }),
    )

    const row = await prisma.{{domainSlug}}.findUnique({ where: { id } })
    expect(row?.deletedAt).not.toBeNull()
  })
})

describe('⑫ @Audit 落 AuditLog，且 tenantId 正确', () => {
  it('create 与 delete 各留下一条记录，tenantId 是操作者自己的店', async () => {
    const name = `A-审计-${RUN}`
    const id = await create{{DomainPascal}}(shopA, name)
    await request(http())
      .delete(`/api/admin/{{domainSlug}}/${id}`)
      .set('Authorization', `Bearer ${shopA.token}`)
      .expect(200)

    // 审计是**旁路**写入（拦截器在响应返回后才写），给它一点时间落库。
    await waitFor(async () => (await countAudit(id, '{{domainSlug}}.delete')) > 0)

    const created = await prisma.auditLog.findMany({
      where: { tenantId: shopA.tenantId, action: '{{domainSlug}}.create' },
      orderBy: { createdAt: 'desc' },
      take: 20,
    })
    expect(created.length).toBeGreaterThan(0)
    expect(created.every((r) => r.tenantId === shopA.tenantId)).toBe(true)
    expect(created[0]?.actorType).toBe('STAFF')
    expect(created[0]?.traceId).toBeTruthy()

    const deleted = await prisma.auditLog.findMany({
      where: { tenantId: shopA.tenantId, action: '{{domainSlug}}.delete', targetId: id },
    })
    expect(deleted.length).toBe(1)
    expect(deleted[0]?.targetType).toBe('{{DomainPascal}}')
    expect(deleted[0]?.result).toBe('SUCCESS')
  })

  it('B 店的审计记录里一条 A 店的都没有', async () => {
    const crossed = await prisma.auditLog.count({
      where: { tenantId: shopB.tenantId, targetId: { in: {{domainSlug}}A } },
    })
    expect(crossed).toBe(0)
  })

  it('平台建租户写的是 PlatformAuditLog，不是租户域的 AuditLog', async () => {
    const platform = await prisma.platformAuditLog.findMany({
      where: { action: 'tenant.create' },
      orderBy: { createdAt: 'desc' },
      take: 5,
    })
    expect(platform.length).toBeGreaterThan(0)
    expect(platform[0]?.actorType).toBe('PLATFORM_ADMIN')
  })
})

