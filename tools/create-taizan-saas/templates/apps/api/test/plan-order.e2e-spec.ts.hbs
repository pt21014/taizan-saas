// ⑤ 退款
// ─────────────────────────────────────────────────────────────────────────────

describe('⑤ 退款回退到期日；续过费之后交人工', () => {
  let shop: Shop
  let firstOrderId = ''
  let expireBefore: Date | null = null

  beforeAll(async () => {
    shop = await createShop(5, { login: true })
    await makeExpired(shop.tenantId)
    const row = await prisma.tenant.findUniqueOrThrow({ where: { id: shop.tenantId } })
    expireBefore = row.planExpireAt

    const created = await request(http())
      .post('/api/admin/billing/orders')
      .set('Authorization', `Bearer ${shop.token}`)
      .send({ planId, periods: 1 })
    const data = expectOk<{ order: { id: string; outTradeNo: string } }>(created.body)
    firstOrderId = data.order.id
    await kit.simulatePaid(data.order.outTradeNo)
  })

  it('退款后到期日回到 expireBeforeAt，订单转 REFUNDED', async () => {
    const res = await authedPlatform()
      .post(`/api/platform/plan-orders/${firstOrderId}/refund`)
      .send({ reason: 'e2e 退款验证' })
    const out = expectOk<{ applied: boolean }>(res.body)
    expect(out.applied).toBe(true)

    const order = await prisma.planOrder.findUniqueOrThrow({ where: { id: firstOrderId } })
    expect(order.status).toBe('REFUNDED')
    const tenant = await prisma.tenant.findUniqueOrThrow({ where: { id: shop.tenantId } })
    expect(tenant.planExpireAt?.toISOString()).toBe(expireBefore?.toISOString())
  })

  it('退款也写了审计（plan-order.refund）', async () => {
    await waitFor(
      async () =>
        (await prisma.auditLog.count({
          where: { tenantId: shop.tenantId, action: 'plan-order.refund' },
        })) >= 1,
    )
  })

  it('续过费之后再退上一笔 → applied:false / SUPERSEDED，什么都不动', async () => {
    // 先把上一笔恢复成 FULFILLED（模拟「退款流程还没走完，中间又续了一次费」）。
    await prisma.planOrder.update({
      where: { id: firstOrderId },
      data: { status: 'FULFILLED' },
    })
    // 再买一单并兑现，把到期日推到更远。
    const created = await request(http())
      .post('/api/admin/billing/orders')
      .set('Authorization', `Bearer ${shop.token}`)
      .send({ planId, periods: 6 })
    const second = expectOk<{ order: { outTradeNo: string } }>(created.body)
    await kit.simulatePaid(second.order.outTradeNo)

    const beforeTenant = await prisma.tenant.findUniqueOrThrow({ where: { id: shop.tenantId } })
    const res = await authedPlatform()
      .post(`/api/platform/plan-orders/${firstOrderId}/refund`)
      .send({ reason: '续过费之后再退，应交人工' })
    const out = expectOk<{ applied: boolean; reason?: string }>(res.body)
    expect(out.applied).toBe(false)
    expect(out.reason).toBe('SUPERSEDED')

    const order = await prisma.planOrder.findUniqueOrThrow({ where: { id: firstOrderId } })
    expect(order.status, '交人工 = 什么都不动，订单状态也不动').toBe('FULFILLED')
    const afterTenant = await prisma.tenant.findUniqueOrThrow({ where: { id: shop.tenantId } })
    expect(afterTenant.planExpireAt?.toISOString()).toBe(beforeTenant.planExpireAt?.toISOString())
  })
})

// ─────────────────────────────────────────────────────────────────────────────
// ⑥ 超时取消
// ─────────────────────────────────────────────────────────────────────────────

describe('⑥ PENDING 单超过 30 分钟被 cron 取消', () => {
  let shop: Shop
  let staleId = ''
  let freshId = ''

  beforeAll(async () => {
    shop = await createShop(6)
    const stale = await authedPlatform()
      .post('/api/platform/plan-orders')
      .send({ tenantId: shop.tenantId, planId, periods: 1, channel: 'OFFLINE' })
    staleId = expectOk<{ id: string }>(stale.body).id
    const fresh = await authedPlatform()
      .post('/api/platform/plan-orders')
      .send({ tenantId: shop.tenantId, planId, periods: 1, channel: 'OFFLINE' })
    freshId = expectOk<{ id: string }>(fresh.body).id

    // 把其中一张的 createdAt 挪到 31 分钟前。
    await prisma.planOrder.update({
      where: { id: staleId },
      data: { createdAt: new Date(Date.now() - 31 * 60 * 1000) },
    })
  })

  it('cancelExpired 只收走超时的那一张，刚下的单不动', async () => {
    const count = await planOrders.cancelExpired()
    expect(count).toBeGreaterThanOrEqual(1)
    expect((await prisma.planOrder.findUniqueOrThrow({ where: { id: staleId } })).status).toBe(
      'CANCELLED',
    )
    expect((await prisma.planOrder.findUniqueOrThrow({ where: { id: freshId } })).status).toBe(
      'PENDING',
    )
  })

  it('已取消的单不能再被兑现（状态机没有 CANCELLED → PAID 这条边）', async () => {
    const res = await authedPlatform().post(`/api/platform/plan-orders/${staleId}/mark-paid`)
    expect(codeOf(res.body)).not.toBe(0)
    expect((await prisma.planOrder.findUniqueOrThrow({ where: { id: staleId } })).status).toBe(
      'CANCELLED',
    )
  })
})

