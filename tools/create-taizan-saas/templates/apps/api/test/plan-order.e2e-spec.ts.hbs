describe('⑦ /api/platform/tenants/:id/renew 产出的订单与 ③ 形状一致', () => {
  let shop: Shop

  beforeAll(async () => {
    shop = await createShop(7)
    await makeExpired(shop.tenantId)
  })

  it('renew 落的是一张 FULFILLED 的 OFFLINE 单，且带齐两个到期日快照', async () => {
    const res = await authedPlatform()
      .patch(`/api/platform/tenants/${shop.tenantId}/renew`)
      .send({ periods: 2 })
    const out = expectOk<{
      tenant: { planExpireAt: string; status: string }
      order: { id: string; outTradeNo: string; amountCents: number }
    }>(res.body)

    const order = await prisma.planOrder.findUniqueOrThrow({ where: { id: out.order.id } })
    expect(fulfillShape(order)).toEqual({
      status: 'FULFILLED',
      type: 'OPEN',
      periods: 2,
      amountCents: FIRST_PRICE_CENTS * 2,
      planId,
      paidAtSet: true,
      fulfilledAtSet: true,
      expireAfterAtSet: true,
    })
    expect(order.payChannel).toBe('OFFLINE')
    expect(order.operatorId).toBeTruthy()
    // T1-5 之前 renew 自己拼的单号是 `renew-<ULID>`，回调根本路由不到它。
    expect(order.outTradeNo.startsWith('PLAN-')).toBe(true)
    expect(order.expireBeforeAt).not.toBeNull()

    expect(out.tenant.planExpireAt).toBe(order.expireAfterAt?.toISOString())
    expect(out.tenant.status).toBe('ACTIVE')
  })

  it('renew 也留下了 plan-order.fulfill 审计（和 ③ 同一条路径，所以同一条记录）', async () => {
    await waitFor(
      async () =>
        (await prisma.auditLog.count({
          where: { tenantId: shop.tenantId, action: 'plan-order.fulfill' },
        })) === 1,
    )
  })
})
