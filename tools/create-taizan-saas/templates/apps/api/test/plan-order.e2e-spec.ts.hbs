describe('④ 金额不符的回调：不兑现、有审计 FAIL、但照常应答成功', () => {
  let shop: Shop
  let outTradeNo = ''
  let orderId = ''

  beforeAll(async () => {
    shop = await createShop(4, { login: true })
    await makeExpired(shop.tenantId)
    const res = await request(http())
      .post('/api/admin/billing/orders')
      .set('Authorization', `Bearer ${shop.token}`)
      .send({ planId, periods: 1 })
    const data = expectOk<{ order: { id: string; outTradeNo: string } }>(res.body)
    outTradeNo = data.order.outTradeNo
    orderId = data.order.id
  })

  it('付 1 分钱买一年：应答仍是 SUCCESS（永久性错误重推不会自愈，别把接口打满）', async () => {
    const res = await kit.simulatePaid(outTradeNo, { amountCents: 1 })
    expect(res.status).toBe(200)
    expect(res.body).toEqual({ code: 'SUCCESS', message: '成功' })
  })

  it('订单还是 PENDING，租户仍然到期', async () => {
    const order = await prisma.planOrder.findUniqueOrThrow({ where: { id: orderId } })
    expect(order.status).toBe('PENDING')
    expect(order.fulfilledAt).toBeNull()
    const tenant = await prisma.tenant.findUniqueOrThrow({ where: { id: shop.tenantId } })
    expect(tenant.planExpireAt!.getTime()).toBeLessThan(Date.now())
  })

  it('PlatformAuditLog 有一条 plan-order.callback 的 FAIL，钱的账留住了', async () => {
    await waitFor(
      async () =>
        (await prisma.platformAuditLog.count({
          where: { action: 'plan-order.callback', targetId: orderId, result: 'FAIL' },
        })) === 1,
    )
    const log = await prisma.platformAuditLog.findFirstOrThrow({
      where: { action: 'plan-order.callback', targetId: orderId },
    })
    expect(log.targetTenantId).toBe(shop.tenantId)
    expect(String((log.after as Record<string, unknown>).reason)).toContain('金额与订单不符')
  })

  it('伪造签名的回调被挡在 400，一个字节都没落库', async () => {
    const before = await prisma.planOrder.findUniqueOrThrow({ where: { id: orderId } })
    const res = await kit.simulatePaid(outTradeNo, { secret: 'wrong-secret' })
    expect(res.status).toBe(400)
    const after = await prisma.planOrder.findUniqueOrThrow({ where: { id: orderId } })
    expect(after.status).toBe(before.status)
  })
})

