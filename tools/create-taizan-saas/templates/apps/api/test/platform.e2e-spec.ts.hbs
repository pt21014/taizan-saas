// ─────────────────────────────────────────────────────────────────────────────
// ⑯ 死信队列：列表 + 重放（真队列：直接调 DeadLetterService.record() 制造一条死信，
// 理由见下——不用真的把一个任务重试到耗尽，那要等好几轮 BullMQ 退避）
// ─────────────────────────────────────────────────────────────────────────────

describe('⑯ 死信队列', () => {
  const QUEUE_NAME = `e2e-dead-letter-${RUN}`
  let deadLetterId = ''

  it(
    '制造一条死信：DeadLetterService.record() 是「任务重试耗尽后落库」这一步本身，' +
      '直接调它等价于真的经历了一轮重试耗尽，且不用等 BullMQ 的退避延迟',
    async () => {
      const deadLetters = app.get(DeadLetterService)
      const payload: JobEnvelope = {
        traceId: ulid(),
        data: { hello: 'e2e' },
        enqueuedAt: Date.now(),
      }
      const id = await deadLetters.record({
        queue: QUEUE_NAME,
        jobName: QUEUE_NAME,
        payload,
        attempts: 5,
        lastError: 'e2e 模拟：上游超时',
        traceId: payload.traceId,
      })
      expect(id).toBeTruthy()
      deadLetterId = id as string
    },
  )

  it('GET /api/platform/jobs/dead-letters 按 queue 筛选能查到这一条', async () => {
    const res = await authed()
      .get(`/api/platform/jobs/dead-letters?queue=${encodeURIComponent(QUEUE_NAME)}`)
      .expect(200)
    const page = expectOk<{ items: { id: string; queue: string; resolvedAt: string | null }[] }>(
      res.body,
    )
    expect(page.items.map((i) => i.id)).toContain(deadLetterId)
    const row = page.items.find((i) => i.id === deadLetterId)
    expect(row?.resolvedAt).toBeNull()
  })

  it('resolved=false 只看待处理，resolved=true 看不到（还没重放）', async () => {
    const pending = await authed()
      .get(`/api/platform/jobs/dead-letters?queue=${encodeURIComponent(QUEUE_NAME)}&resolved=false`)
      .expect(200)
    expect(expectOk<{ items: { id: string }[] }>(pending.body).items.map((i) => i.id)).toContain(
      deadLetterId,
    )

    const resolved = await authed()
      .get(`/api/platform/jobs/dead-letters?queue=${encodeURIComponent(QUEUE_NAME)}&resolved=true`)
      .expect(200)
    expect(
      expectOk<{ items: { id: string }[] }>(resolved.body).items.map((i) => i.id),
    ).not.toContain(deadLetterId)
  })

  it('POST .../replay 原样重新入队，成功后 resolvedAt 非空（先入队再标记，见 DeadLetterService 文件头）', async () => {
    const res = await authed()
      .post(`/api/platform/jobs/dead-letters/${deadLetterId}/replay`)
      .expect(201)
    const data = expectOk<{ jobId: string }>(res.body)
    expect(data.jobId).toBeTruthy()

    const row = await prisma.jobDeadLetter.findUniqueOrThrow({ where: { id: deadLetterId } })
    expect(row.resolvedAt).not.toBeNull()
  })

  it('重放一个不存在的死信 → 1850000（JOB_REPLAY_FAILED）', async () => {
    const res = await authed().post(`/api/platform/jobs/dead-letters/${ulid()}/replay`)
    expect(codeOf(res.body)).toBe(1850000)
  })

  it('GET /api/platform/jobs/cron-runs 能查到一条手工插入的运行记录', async () => {
    const cronKey = `e2e-cron-${RUN}`
    await prisma.cronRun.create({
      data: {
        id: ulid(),
        key: cronKey,
        startedAt: new Date(),
        finishedAt: new Date(),
        instanceId: 'e2e-instance',
        ok: true,
      },
    })

    const res = await authed().get(`/api/platform/jobs/cron-runs?key=${cronKey}`).expect(200)
    const page = expectOk<{ items: { key: string; ok: boolean }[] }>(res.body)
    expect(page.items.length).toBeGreaterThanOrEqual(1)
    expect(page.items.every((i) => i.key === cronKey)).toBe(true)
    expect(page.items[0]?.ok).toBe(true)
  })
})

