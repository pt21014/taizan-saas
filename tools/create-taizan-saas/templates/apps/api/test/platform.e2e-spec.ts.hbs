describe('⑰ 看板：即将到期租户明细', () => {
  const EXPIRING_SHOP = { slug: `e2e-expiring-${RUN}`, name: `即将到期 ${RUN}`, phone: phoneFor(2) }
  let expiringTenantId = ''

  it('开一家 3 天后到期的试用店', async () => {
    const res = await authed()
      .post('/api/platform/tenants')
      .send({
        slug: EXPIRING_SHOP.slug,
        name: EXPIRING_SHOP.name,
        ownerPhone: EXPIRING_SHOP.phone,
        ownerPassword: OWNER_PASSWORD,
        trialDays: 3,
      })
      .expect(201)
    const data = expectOk<{ tenant: { id: string; status: string; planExpireAt: string } }>(
      res.body,
    )
    expiringTenantId = data.tenant.id
    expect(data.tenant.status).toBe('TRIAL')
  })

  it('GET /api/platform/dashboard/expiring?days=7 明细含这家店，带 slug/name/planExpireAt/daysLeft', async () => {
    const res = await authed()
      .get('/api/platform/dashboard/expiring?days=7&pageSize=200')
      .expect(200)
    const page = expectOk<{
      items: { id: string; slug: string; name: string; planExpireAt: string; daysLeft: number }[]
      total: number
    }>(res.body)

    const row = page.items.find((i) => i.id === expiringTenantId)
    expect(row, '3 天后到期的店应该出现在 7 天内到期明细里').toBeTruthy()
    expect(row?.slug).toBe(EXPIRING_SHOP.slug)
    expect(row?.name).toBe(EXPIRING_SHOP.name)
    // `trialDays: 3` 算出来的 `planExpireAt` 是「3 天后那一天的日历日终点」
    // （`computeTrialEnd` = `endOfCalendarDay(addCalendarDays(今天, 3))`），不是精确的
    // now+72h——如果建号时刻本身就接近当天末尾，`Math.ceil((到期-此刻)/1天)` 可能算出 4
    // 而不是 3。断言留一点余量（0~4），不假装两套时间口径能精确对上。
    expect(row?.daysLeft).toBeGreaterThanOrEqual(0)
    expect(row?.daysLeft).toBeLessThanOrEqual(4)
  })

  it('days=1 时这家店（3 天后到期）不出现——过滤窗口真的生效，不是把全表都下发了', async () => {
    const res = await authed()
      .get('/api/platform/dashboard/expiring?days=1&pageSize=200')
      .expect(200)
    const page = expectOk<{ items: { id: string }[] }>(res.body)
    expect(page.items.map((i) => i.id)).not.toContain(expiringTenantId)
  })
})

// ─────────────────────────────────────────────────────────────────────────────
// ⑱ MFA 开关位：enable/verify 往返（登录时是否强制校验仍是 TODO，见 platform-auth.service.ts）
// ─────────────────────────────────────────────────────────────────────────────

describe('⑱ MFA 开关位', () => {
  let secret = ''

  it('POST enable 生成 TOTP secret，返回 otpauth URL', async () => {
    const res = await authed().post('/api/platform/admins/me/mfa/enable').expect(201)
    const data = expectOk<{ otpauthUrl: string }>(res.body)
    expect(data.otpauthUrl.startsWith('otpauth://totp/')).toBe(true)

    const query = new URL(data.otpauthUrl).searchParams
    secret = query.get('secret') ?? ''
    expect(secret).toBeTruthy()
  })

  it('POST verify 用正确的一次性码校验通过', async () => {
    const code = totp(secret)
    const res = await authed().post('/api/platform/admins/me/mfa/verify').send({ code }).expect(201)
    expect(expectOk<{ verified: boolean }>(res.body).verified).toBe(true)
  })

  it('错误的一次性码 → 1140100（UNAUTHENTICATED）', async () => {
    const res = await authed().post('/api/platform/admins/me/mfa/verify').send({ code: '000000' })
    expect(codeOf(res.body)).toBe(1140100)
  })

  it('格式不对（不是 6 位数字）在 DTO 校验这一层就被拒（BAD_REQUEST）', async () => {
    const res = await authed().post('/api/platform/admins/me/mfa/verify').send({ code: 'abcdef' })
    expect(codeOf(res.body)).toBe(1040000)
  })
})

// ─────────────────────────────────────────────────────────────────────────────
// ⑲ 默认拒绝：platform 命名空间零豁免（这里只做运行时抽查，静态扫描见 test/arch）
// ─────────────────────────────────────────────────────────────────────────────

describe('⑲ 默认拒绝', () => {
  it('不带 token 打任意一个 T1-7/T3-4 新接口都是 1140100', async () => {
    const paths = [
      '/api/platform/admins',
      '/api/platform/plans',
      '/api/platform/orders',
      '/api/platform/role-presets',
      '/api/platform/announcements',
      '/api/platform/audit-logs',
      '/api/platform/dashboard/overview',
      '/api/platform/dashboard/expiring',
      '/api/platform/jobs/dead-letters',
      '/api/platform/jobs/cron-runs',
      `/api/platform/tenants/${tenantId}/overview`,
      `/api/platform/tenants/${tenantId}/audit-logs`,
    ]
    for (const path of paths) {
      const res = await request(http()).get(path)
      expect(codeOf(res.body), `${path} 无 token 应为 1140100`).toBe(1140100)
    }

    // POST/replay 与 MFA 两条是 @Post，用 GET 打会先撞路由不存在（Nest 404，不是信封），
    // 单独用正确方法验证零 token 的默认拒绝。
    const postPaths = [
      `/api/platform/jobs/dead-letters/${ulid()}/replay`,
      '/api/platform/admins/me/mfa/enable',
      '/api/platform/admins/me/mfa/verify',
    ]
    for (const path of postPaths) {
      const res = await request(http()).post(path).send({})
      expect(codeOf(res.body), `${path} 无 token 应为 1140100`).toBe(1140100)
    }
  })
})
