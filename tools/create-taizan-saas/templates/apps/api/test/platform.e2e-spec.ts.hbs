let adminBId = ''
let adminBPassword = ''
const adminBUsername = `e2e-admin-b-${RUN}`

describe('⑨ 平台管理员', () => {
  it('新建管理员（不给口令，随机生成回明文）', async () => {
    const res = await authed()
      .post('/api/platform/admins')
      .send({ username: adminBUsername, name: '协管 B' })
      .expect(201)
    const data = expectOk<{ admin: { id: string; status: string }; initialPassword: string }>(
      res.body,
    )
    adminBId = data.admin.id
    adminBPassword = data.initialPassword
    expect(data.admin.status).toBe('ACTIVE')
    expect(data.initialPassword).toBeTruthy()
  })

  it('roleIds 引用不存在的角色预设会被拒', async () => {
    const res = await authed()
      .post('/api/platform/admins')
      .send({ username: `${adminBUsername}-x`, name: 'x', roleIds: [ulid()] })
    expect(codeOf(res.body)).toBe(1040000)
  })

  it(
    '重置口令后旧 token 失效（用 B 自己的会话验证，不去动 admin 本人那一个——' +
      'platform 并发端数上限是 1，再登录一次 admin 会把本文件全程复用的 platformToken 挤下线）',
    async () => {
      const loginB = await loginRequest('/api/platform/auth/login')
        .send({ username: adminBUsername, password: adminBPassword })
        .expect(201)
      const tokenB = expectOk<{ access: string }>(loginB.body).access

      const stillAlive = await request(http())
        .get('/api/platform/auth/me')
        .set('Authorization', `Bearer ${tokenB}`)
      expect(stillAlive.status).toBe(200)

      const reset = await authed()
        .patch(`/api/platform/admins/${adminBId}/password`)
        .send({})
        .expect(200)
      expect(expectOk<{ initialPassword: string }>(reset.body).initialPassword).toBeTruthy()

      const revoked = await request(http())
        .get('/api/platform/auth/me')
        .set('Authorization', `Bearer ${tokenB}`)
      expect(codeOf(revoked.body)).toBe(1140100)

      // 全程复用的 platformToken（admin 本人）完全没被这次操作影响。
      const untouched = await authed().get('/api/platform/auth/me')
      expect(untouched.status).toBe(200)
    },
  )

  it('列表 / 详情 / 改名', async () => {
    const list = await authed().get('/api/platform/admins?pageSize=200').expect(200)
    expect(expectOk<{ items: { id: string }[] }>(list.body).items.map((i) => i.id)).toContain(
      adminBId,
    )

    const updated = await authed()
      .patch(`/api/platform/admins/${adminBId}`)
      .send({ name: '协管 B（改名）' })
      .expect(200)
    expect(expectOk<{ name: string }>(updated.body).name).toBe('协管 B（改名）')
  })

  it('停用 B（此刻 2 个 ACTIVE，允许）；不能停用自己（此刻只剩 1 个 ACTIVE）', async () => {
    const disabled = await authed().patch(`/api/platform/admins/${adminBId}/disable`).expect(200)
    expect(expectOk<{ status: string }>(disabled.body).status).toBe('DISABLED')

    const seedAdmin = await prisma.platformAdmin.findFirstOrThrow({ where: { username: 'admin' } })
    const selfDisable = await authed().patch(`/api/platform/admins/${seedAdmin.id}/disable`)
    expect(codeOf(selfDisable.body)).toBe(1040000)

    // 启用回来，不影响后面用例。
    await authed().patch(`/api/platform/admins/${adminBId}/enable`).expect(200)
  })
})

