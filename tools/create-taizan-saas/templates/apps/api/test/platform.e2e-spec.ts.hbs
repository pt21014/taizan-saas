const RUN = ulid().slice(-8).toLowerCase()

/**
 * 本文件的登录请求专用的「客户端 IP」（起法与 `plan-order.e2e-spec.ts` 一致）。
 *
 * `login` 档限流是**按客户端 IP** 计的（5 分钟 10 次），而 e2e 的每个文件都从
 * `127.0.0.1` 打过来——`vitest.e2e.config.ts` 又刻意 `fileParallelism: false` 串行跑，
 * 于是几个文件共用同一个桶。本文件一趟要登 6 次（平台 2 次 + 店主 4 次），
 * 加上别的文件就超过 10：**后面的文件会拿到 `1042900` 而不是它想断言的东西**，
 * 而失败信息长得像「登录逻辑坏了」，最难查。
 *
 * 应用开着 `trust proxy`（`TRUSTED_PROXY_HOPS=1`），带一个 `X-Forwarded-For`
 * 就能让本文件的登录落进自己的桶里：既不消耗别人的额度，也不受别人影响。
 * 这不是在绕过限流——限流本身由 `test/ratelimit.e2e-spec.ts` 专门验证。
 *
 * IP 里掺 `RUN`：同一天重复跑 e2e 时，Redis 里上一趟的计数还在窗口内。
 */
const LOGIN_IP = `10.98.${([...RUN].reduce((a, c) => (a + c.charCodeAt(0)) % 200, 3) + 1).toString()}.7`

/** 本文件所有登录请求的统一起手式：一定带上 {@link LOGIN_IP}。 */
function loginRequest(url: string) {
  return request(http()).post(url).set('X-Forwarded-For', LOGIN_IP)
}

let app: INestApplication
let prisma: PrismaClient

function http(): Parameters<typeof request>[0] {
  return app.getHttpServer() as Parameters<typeof request>[0]
}

function expectOk<T>(body: unknown): T {
  const envelope = body as { code: number; message: string; data: T }
  expect(envelope.code, `期望 code=0，实际：${JSON.stringify(envelope)}`).toBe(0)
  return envelope.data
}

function codeOf(body: unknown): number {
  return (body as { code: number }).code
}

/** 造一个本次运行专用的手机号，避免和 seed / 其它 e2e 文件的手机号撞。 */
function phoneFor(n: number): string {
  const digits = [...RUN]
    .map((c) => c.charCodeAt(0) % 10)
    .join('')
    .slice(0, 7)
  return `138${digits}${n}`
}

let platformToken = ''

beforeAll(async () => {
  prisma = new PrismaClient()

  await seedBase(
    {
      platformAdmin: prisma.platformAdmin,
      plan: prisma.plan,
      tenant: prisma.tenant,
      staffAccount: prisma.staffAccount,
      staff: findFirstUpsertDelegate(prisma.staff),
      role: findFirstUpsertDelegate(prisma.role),
      rolePreset: prisma.rolePreset,
    },
    { withDemoTenant: false },
  )

  const moduleRef = await Test.createTestingModule({ imports: [AppModule] }).compile()
  app = moduleRef.createNestApplication({ logger: false })
  configureApp(app)
  await app.init()

  const login = await loginRequest('/api/platform/auth/login')
    .send({ username: 'admin', password: 'admin123' })
    .expect(201)
  platformToken = expectOk<{ access: string }>(login.body).access
})

afterAll(async () => {
  await app?.close()
  await prisma?.$disconnect()
})

function authed() {
  return {
    get: (url: string) => request(http()).get(url).set('Authorization', `Bearer ${platformToken}`),
    post: (url: string) =>
      request(http()).post(url).set('Authorization', `Bearer ${platformToken}`),
    patch: (url: string) =>
      request(http()).patch(url).set('Authorization', `Bearer ${platformToken}`),
    delete: (url: string) =>
      request(http()).delete(url).set('Authorization', `Bearer ${platformToken}`),
  }
}

/** 轮询等待一个条件成立（审计是旁路写入，响应返回时不保证已经落库）。 */
async function waitFor(check: () => Promise<boolean>, timeoutMs = 5000): Promise<void> {
  const deadline = Date.now() + timeoutMs
  for (;;) {
    if (await check()) return
    if (Date.now() > deadline) throw new Error(`等待超时（${timeoutMs}ms）`)
    await new Promise((resolve) => setTimeout(resolve, 100))
  }
}

async function auditActionSeen(action: string, targetId?: string): Promise<boolean> {
  const res = await authed().get(
    `/api/platform/audit-logs?action=${encodeURIComponent(action)}&pageSize=200`,
  )
  const page = expectOk<{ items: { action: string; targetId: string | null }[] }>(res.body)
  return targetId
    ? page.items.some((i) => i.action === action && i.targetId === targetId)
    : page.items.some((i) => i.action === action)
}

