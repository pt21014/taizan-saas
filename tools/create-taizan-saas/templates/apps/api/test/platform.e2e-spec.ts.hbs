describe('④ 续期', () => {
  it('续期后 planExpireAt 正确（与 computeRenewal 独立算出来的结果一致），且落一条 PlanOrder', async () => {
    const before = await prisma.tenant.findUniqueOrThrow({ where: { id: tenantId } })
    const plan = await prisma.plan.findUniqueOrThrow({ where: { id: planId } })

    const res = await authed()
      .patch(`/api/platform/tenants/${tenantId}/renew`)
      .send({ planId, periods: 1 })
      .expect(200)
    const result = expectOk<{
      tenant: { planExpireAt: string; status: string; planId: string | null }
      order: { id: string; amountCents: number }
    }>(res.body)

    // `currentExpireAt`（试用到期日）此刻必然还在未来，所以 computeRenewal 的 `base`
    // 只取决于 currentExpireAt，与"现在"的微小时间差无关——这条断言不会因为跑得慢一点点而 flaky。
    const expected = computeRenewal({
      currentExpireAt: before.planExpireAt,
      now: new Date(),
      periods: 1,
      periodMonths: plan.periodMonths,
    })
    expect(result.tenant.planExpireAt).toBe(expected.expireAfterAt.toISOString())
    expect(result.tenant.planId).toBe(planId)
    // 续过费之前是 TRIAL（还没挂套餐），续费之后必须转 ACTIVE。
    expect(result.tenant.status).toBe('ACTIVE')
    // **首开价，不是续费价**——T1-5 把续期收口到 `PlanOrderService` 之后，单价由
    // 「这家店有没有 FULFILLED 过订单」决定（`computeOrderAmount`）。这家店是第一次
    // 付钱，收首开价才对；T1-5 之前这里无条件用 renewPriceCents，那是笔少收的钱。
    expect(result.order.amountCents).toBe(plan.firstPriceCents)

    const orders = await prisma.planOrder.findMany({ where: { tenantId } })
    expect(orders).toHaveLength(1)
    expect(orders[0]?.status).toBe('FULFILLED')
    // 同因：从没兑现过 → OPEN。第二次点续期才是 RENEW。
    expect(orders[0]?.type).toBe('OPEN')
    expect(orders[0]?.payChannel).toBe('OFFLINE')
    // 单号带 PLAN 前缀（T1-5 之前是 `renew-<ULID>`，支付回调根本路由不到它）。
    expect(orders[0]?.outTradeNo.startsWith('PLAN-')).toBe(true)
  })

  it('订单查询接口能查到这条订单（列表 + 详情）', async () => {
    const list = await authed().get(`/api/platform/orders?tenantId=${tenantId}`).expect(200)
    const page = expectOk<{ items: { id: string }[]; total: number }>(list.body)
    expect(page.total).toBe(1)
    const orderId = page.items[0]?.id as string

    const detail = await authed().get(`/api/platform/orders/${orderId}`).expect(200)
    expect(expectOk<{ tenantId: string }>(detail.body).tenantId).toBe(tenantId)
  })

  it('更换套餐：换回同一个套餐也应该成功（幂等的写法，不因为"没变"就报错）', async () => {
    const res = await authed()
      .patch(`/api/platform/tenants/${tenantId}/change-plan`)
      .send({ planId })
      .expect(200)
    expect(expectOk<{ planId: string }>(res.body).planId).toBe(planId)
  })
})

