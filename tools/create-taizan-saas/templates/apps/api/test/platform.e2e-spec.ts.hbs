let planId = ''
const planCode = `e2e-${RUN}`

describe('② 套餐管理', () => {
  it('新建套餐：quotas 三态（上限/禁用/不限）一次性入库', async () => {
    const res = await authed()
      .post('/api/platform/plans')
      .send({
        code: planCode,
        name: `E2E 套餐 ${RUN}`,
        firstPriceCents: 10_000,
        renewPriceCents: 8_000,
        periodMonths: 1,
        quotas: { STAFF: 3, TRAFFIC_MB: 0, MEMBER: null },
        features: ['member'],
        appKeys: ['admin'],
      })
      .expect(201)
    const plan = expectOk<{
      id: string
      quotas: Record<string, number | null>
      features: string[] | null
      status: string
    }>(res.body)
    planId = plan.id
    expect(plan.quotas).toEqual({ STAFF: 3, TRAFFIC_MB: 0, MEMBER: null })
    expect(plan.features).toEqual(['member'])
    expect(plan.status).toBe('ENABLED')
  })

  it('code 重复被拒', async () => {
    const res = await authed()
      .post('/api/platform/plans')
      .send({
        code: planCode,
        name: '重名套餐',
        firstPriceCents: 0,
        renewPriceCents: 0,
        periodMonths: 1,
        quotas: {},
        appKeys: ['admin'],
      })
    expect(codeOf(res.body)).toBe(1040000)
  })

  it('PATCH 只改一个配额维度，其余维度不动（三态里"缺省"的合并语义）', async () => {
    const res = await authed()
      .patch(`/api/platform/plans/${planId}`)
      .send({ quotas: { STAFF: null } })
      .expect(200)
    const plan = expectOk<{ quotas: Record<string, number | null> }>(res.body)
    expect(plan.quotas.STAFF).toBeNull()
    // TRAFFIC_MB / MEMBER 没在这次 patch 里提到，必须原样保留。
    expect(plan.quotas.TRAFFIC_MB).toBe(0)
    expect(plan.quotas.MEMBER).toBeNull()
  })

  it('PATCH features: null 显式清空为"全部可用"，与"不传"是两回事', async () => {
    const res = await authed()
      .patch(`/api/platform/plans/${planId}`)
      .send({ features: null })
      .expect(200)
    const plan = expectOk<{ features: string[] | null }>(res.body)
    expect(plan.features).toBeNull()
  })

  it('下架 → 归档 → 上架，状态机走一遍', async () => {
    const disabled = expectOk<{ status: string }>(
      (await authed().patch(`/api/platform/plans/${planId}/disable`).expect(200)).body,
    )
    expect(disabled.status).toBe('DISABLED')

    const archived = expectOk<{ status: string }>(
      (await authed().patch(`/api/platform/plans/${planId}/archive`).expect(200)).body,
    )
    expect(archived.status).toBe('ARCHIVED')

    const enabled = expectOk<{ status: string }>(
      (await authed().patch(`/api/platform/plans/${planId}/enable`).expect(200)).body,
    )
    expect(enabled.status).toBe('ENABLED')
  })

  it('调整排序', async () => {
    const res = await authed()
      .patch(`/api/platform/plans/${planId}/sort`)
      .send({ sort: 999 })
      .expect(200)
    expect(expectOk<{ sort: number }>(res.body).sort).toBe(999)
