describe('⑤ 冻结', () => {
  it('冻结成功', async () => {
    const res = await authed().patch(`/api/platform/tenants/${tenantId}/suspend`).expect(200)
    expect(expectOk<{ status: string }>(res.body).status).toBe('SUSPENDED')
  })

  it('冻结立即生效：手上那张还没过期的旧 token 写操作被 BillingGateGuard 拦（1440301）', async () => {
    // `evaluateTenantGate` 对 SUSPENDED 是"硬闸门"，不受 BILLING_ENFORCE 影响，
    // 也不等成员关系缓存过期——但 `PlatformGateway` 有 30 秒进程内缓存，
    // 所以 `suspend()` 必须调用 `invalidate(tenantId)`，这条用例就是验证这一点接上了没有。
    const res = await request(http())
      .post('/api/admin/{{domainSlug}}')
      .set('Authorization', `Bearer ${ownerToken}`)
      .send({ name: `A-冻结后尝试-${RUN}`, priceCents: 100 })
    expect(codeOf(res.body)).toBe(1440301)
  })

  it('读操作仍然放行（到期/冻结是"只读"不是"断网"）', async () => {
    const res = await request(http())
      .get('/api/admin/{{domainSlug}}')
      .set('Authorization', `Bearer ${ownerToken}`)
    expect(codeOf(res.body)).toBe(0)
  })

  it('冻结之后再次登录：这家店从"账号名下可用店铺"里消失，1140100', async () => {
    const res = await loginRequest('/api/admin/auth/login').send({
      phone: SHOP.phone,
      password: OWNER_PASSWORD,
      tenantId,
    })
    expect(codeOf(res.body)).toBe(1140100)
  })

  it('重复冻结被拒', async () => {
    const res = await authed().patch(`/api/platform/tenants/${tenantId}/suspend`)
    expect(codeOf(res.body)).toBe(1040000)
  })
})

describe('⑥ 解冻', () => {
  it('解冻成功，且因为已经挂了套餐，回到 ACTIVE 而不是 TRIAL', async () => {
    const res = await authed().patch(`/api/platform/tenants/${tenantId}/resume`).expect(200)
    expect(expectOk<{ status: string }>(res.body).status).toBe('ACTIVE')
  })

  it('解冻之后店主能重新登录', async () => {
    const res = await loginRequest('/api/admin/auth/login')
      .send({ phone: SHOP.phone, password: OWNER_PASSWORD, tenantId })
      .expect(201)
    expect(expectOk<{ needChooseShop: boolean }>(res.body).needChooseShop).toBe(false)
  })
})

// ─────────────────────────────────────────────────────────────────────────────
// ⑦ 重置店主口令 → 旧 token 失效
// ─────────────────────────────────────────────────────────────────────────────

describe('⑦ 重置店主口令', () => {
  it('重置后旧 token 立即失效（会话被 revokeAll）', async () => {
    // ownerToken 是③里登录拿到的、这一刻仍然没过期的老 token。
    const before = await request(http())
      .get('/api/admin/auth/bootstrap')
      .set('Authorization', `Bearer ${ownerToken}`)
    expect(before.status).toBe(200)

    const res = await authed()
      .patch(`/api/platform/tenants/${tenantId}/reset-owner-password`)
      .send({})
      .expect(200)
    const data = expectOk<{ phone: string; initialPassword: string | null }>(res.body)
    expect(data.phone).toBe(SHOP.phone)
    expect(data.initialPassword).toBeTruthy() // 没显式指定新口令，回明文。

    const after = await request(http())
      .get('/api/admin/auth/bootstrap')
      .set('Authorization', `Bearer ${ownerToken}`)
    expect(codeOf(after.body)).toBe(1140100)

    // 用新口令能登录。
    const relogin = await loginRequest('/api/admin/auth/login')
      .send({ phone: SHOP.phone, password: data.initialPassword, tenantId })
      .expect(201)
