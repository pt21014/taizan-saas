  it('列表能查到刚建的套餐', async () => {
    const res = await authed().get('/api/platform/plans?pageSize=200').expect(200)
    const page = expectOk<{ items: { id: string }[] }>(res.body)
    expect(page.items.map((i) => i.id)).toContain(planId)
  })
})

