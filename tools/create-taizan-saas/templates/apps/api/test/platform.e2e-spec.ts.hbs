describe('⑫ 审计日志', () => {
  it('平台侧审计（PlatformAuditLog）能查到本文件做过的高危操作', async () => {
    // 审计是拦截器在响应返回后才写的旁路操作（`AuditInterceptor` 文件头），这里
    // 逐条 `waitFor`（而不是只等第一条）：前面几十个用例各自触发的写入是并发落盘的，
    // 用一次等待去赌"全部都已经落库"在慢机器/共享库上会偶发 flaky。
    for (const action of [
      'tenant.create',
      'tenant.renew',
      'tenant.change-plan',
      'tenant.suspend',
      'tenant.resume',
      'tenant.reset-owner-password',
      'tenant.deregister',
      'plan.create',
      'plan.update',
      'plan.publish',
      'plan.unpublish',
      'plan.archive',
      'plan.sort',
      'platform-admin.create',
      'platform-admin.update',
      'platform-admin.reset-password',
      'platform-admin.disable',
      'platform-admin.enable',
      'role-preset.create',
      'role-preset.update',
      'role-preset.delete',
      'announcement.create',
      'announcement.publish',
      'announcement.unpublish',
      'announcement.delete',
    ]) {
      await waitFor(() => auditActionSeen(action), 15_000)
      expect(await auditActionSeen(action), `动作 ${action} 应该出现在平台审计日志里`).toBe(true)
    }
  }, 60_000)

  it('按 targetTenantId 筛选能定位到这家店的操作', async () => {
    const res = await authed().get(
      `/api/platform/audit-logs?action=tenant.suspend&targetTenantId=${tenantId}`,
    )
    const page = expectOk<{ items: unknown[] }>(res.body)
    expect(page.items.length).toBeGreaterThan(0)
  })

  it('租户域审计（AuditLog）：店主建商品那条动作能通过"某租户的审计日志"接口查到', async () => {
    const res = await authed().get(`/api/platform/tenants/${tenantId}/audit-logs`).expect(200)
    const page = expectOk<{ items: { action: string; tenantId: string }[] }>(res.body)
    expect(page.items.every((i) => i.tenantId === tenantId)).toBe(true)
    expect(page.items.some((i) => i.action === '{{domainSlug}}.create')).toBe(true)
  })
})

