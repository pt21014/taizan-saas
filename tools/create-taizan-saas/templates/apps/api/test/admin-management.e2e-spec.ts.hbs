      codeOf(blocked.body),
      '硬删的话那个员工会**悄悄少一批权限**（rolesOf 把查不到的角色当成空集），而后台上看不出来。',
    ).toBe(1040000)
    expect(messageOf(blocked.body)).toContain('1 名员工')

    expectOk(
      (
        await request(http())
          .patch(`/api/admin/staff/${holder.staffId}`)
          .set('Authorization', `Bearer ${shop.token}`)
          .send({ roleIds: [] })
      ).body,
    )

    const removed = await request(http())
      .delete(`/api/admin/roles/${createdRoleId}`)
      .set('Authorization', `Bearer ${shop.token}`)
    expect(expectOk<{ id: string }>(removed.body).id).toBe(createdRoleId)
  })
})

