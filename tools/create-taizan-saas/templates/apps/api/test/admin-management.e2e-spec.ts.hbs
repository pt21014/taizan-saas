          id: ulid(),
          title: row.title,
          contentHtml: `<p>${row.title}</p>`,
          audience: row.audience,
          ...(row.refs === undefined ? {} : { audienceRefs: [...row.refs] }),
          level: 'INFO',
          publishAt: yesterday,
          status: 'PUBLISHED',
        },
      })
      if (row.key === 'all') allTenantId = created.id
    }

    // 两条不该出现的：一条已过期、一条还是草稿。
    await prisma.announcement.create({
      data: {
        id: ulid(),
        title: `已过期公告 ${RUN}`,
        contentHtml: '<p>过期</p>',
        audience: 'ALL_TENANT',
        level: 'INFO',
        publishAt: new Date(Date.now() - 48 * 60 * 60 * 1000),
        expireAt: yesterday,
        status: 'PUBLISHED',
      },
    })
    await prisma.announcement.create({
      data: {
        id: ulid(),
        title: `草稿公告 ${RUN}`,
        contentHtml: '<p>草稿</p>',
        audience: 'ALL_TENANT',
        level: 'INFO',
        publishAt: yesterday,
        status: 'DRAFT',
      },
    })
  })

  it('ALL_TENANT / 命中套餐 / 点名本店 三条都看得到', async () => {
    const res = await request(http())
      .get('/api/admin/announcements')
      .query({ pageSize: 200 })
      .set('Authorization', `Bearer ${shop.token}`)
      .expect(200)
    const titles = expectOk<{ items: { title: string }[] }>(res.body).items.map((i) => i.title)

    expect(titles).toContain(`全平台公告 ${RUN}`)
    expect(titles).toContain(`按套餐公告 ${RUN}`)
    expect(titles).toContain(`点名本店公告 ${RUN}`)
  })

  it('点名别家的 / 给会员的 / 已过期的 / 草稿 四条都看不到', async () => {
    const res = await request(http())
      .get('/api/admin/announcements')
      .query({ pageSize: 200 })
      .set('Authorization', `Bearer ${shop.token}`)
      .expect(200)
    const titles = expectOk<{ items: { title: string }[] }>(res.body).items.map((i) => i.title)

    expect(titles).not.toContain(`点名别家公告 ${RUN}`)
    expect(titles, 'C_END 是发给会员的，商家后台一律不显示').not.toContain(`会员公告 ${RUN}`)
    expect(titles).not.toContain(`已过期公告 ${RUN}`)
    expect(titles).not.toContain(`草稿公告 ${RUN}`)
  })

  it('标记已读：列表里 read 变 true，且**重复标记不刷新首次已读时间**', async () => {
    const first = await request(http())
      .post(`/api/admin/announcements/${allTenantId}/read`)
      .set('Authorization', `Bearer ${shop.token}`)
    const readAt = expectOk<{ readAt: string }>(first.body).readAt

    const again = await request(http())
      .post(`/api/admin/announcements/${allTenantId}/read`)
      .set('Authorization', `Bearer ${shop.token}`)
    expect(
      expectOk<{ readAt: string }>(again.body).readAt,
      '每次点开都刷新首次已读时间的话，「发出去 3 天了还有人没看」这种统计永远是假的。',
    ).toBe(readAt)

    const list = await request(http())
      .get('/api/admin/announcements')
      .query({ pageSize: 200 })
      .set('Authorization', `Bearer ${shop.token}`)
      .expect(200)
    const row = expectOk<{ items: { id: string; read: boolean }[] }>(list.body).items.find(
      (i) => i.id === allTenantId,
    )
    expect(row?.read).toBe(true)
  })

  it('unreadOnly 把已读的那条滤掉；标记别家的公告为已读 → 1940400', async () => {
    const unread = await request(http())
      .get('/api/admin/announcements')
      .query({ pageSize: 200, unreadOnly: 'true' })
      .set('Authorization', `Bearer ${shop.token}`)
      .expect(200)
    const ids = expectOk<{ items: { id: string }[] }>(unread.body).items.map((i) => i.id)
    expect(ids).not.toContain(allTenantId)

    const foreign = await prisma.announcement.findFirst({
      where: { title: `点名别家公告 ${RUN}` },
      select: { id: true },
    })
    const res = await request(http())
      .post(`/api/admin/announcements/${foreign?.id}/read`)
      .set('Authorization', `Bearer ${shop.token}`)
    expect(
      codeOf(res.body),
      '「不可见」与「不存在」回同一个码：区分开就等于提供一个「平台给别家店发了什么」的探测器。',
    ).toBe(1940400)
  })
})

// ─────────────────────────────────────────────────────────────────────────────
// ⑨ 个人设置与改密
// ─────────────────────────────────────────────────────────────────────────────

describe('⑨ 个人设置与改密', () => {
  let shop: Shop

  beforeAll(async () => {
    shop = await createShop(11, '个人设置')
  })

  it('读得到自己的资料（账号级 + 当前店里的身份）', async () => {
    const res = await request(http())
      .get('/api/admin/profile')
      .set('Authorization', `Bearer ${shop.token}`)
      .expect(200)
    const data = expectOk<{ phone: string; staffId: string; isOwner: boolean }>(res.body)
    expect(data.phone).toBe(shop.ownerPhone)
    expect(data.staffId).toBe(shop.staffId)
    expect(data.isOwner).toBe(true)
  })

  it('改显示名 → bootstrap 的 identity.name 跟着变（顶栏读的就是这一份）', async () => {
    const patched = await request(http())
      .patch('/api/admin/profile')
      .set('Authorization', `Bearer ${shop.token}`)
      .send({ name: `改过名的店主 ${RUN}`, avatar: 'https://{{rootDomain}}/a.png' })
    expect(expectOk<{ name: string }>(patched.body).name).toBe(`改过名的店主 ${RUN}`)

    const boot = await bootstrapOf(shop.token)
    expect(boot.identity.name).toBe(`改过名的店主 ${RUN}`)
  })

  it('旧密码不对 → 1140100，且口令没被改动', async () => {
    const res = await request(http())
      .post('/api/admin/profile/change-password')
      .set('Authorization', `Bearer ${shop.token}`)
      .send({ oldPassword: 'definitely-wrong', newPassword: 'brand-new-pass-1' })
    expect(codeOf(res.body)).toBe(1140100)

    // 原口令仍然能登录 = 真的没改。
    const session = await login(shop.ownerPhone, PASSWORD, shop.tenantId)
    expect(session.access).toBeTruthy()
  })

  it('改密成功 → 旧 token 立刻失效，新密码能登录', async () => {
    const changed = await request(http())
      .post('/api/admin/profile/change-password')
      .set('Authorization', `Bearer ${shop.token}`)
      .send({ oldPassword: PASSWORD, newPassword: 'brand-new-pass-1' })
    const result = expectOk<{ ok: boolean; revokedStaffCount: number }>(changed.body)
    expect(result.ok).toBe(true)
    expect(result.revokedStaffCount).toBeGreaterThanOrEqual(1)

    const stale = await request(http())
      .get('/api/admin/profile')
      .set('Authorization', `Bearer ${shop.token}`)
    expect(
      codeOf(stale.body),
      '改密的动机通常就是「我怀疑号被盗了」，这时候还留着别的端在线，改密就白改了。',
    ).toBe(1140100)

    const session = await login(shop.ownerPhone, 'brand-new-pass-1', shop.tenantId)
    expect(session.access).toBeTruthy()
  })
})

// ─────────────────────────────────────────────────────────────────────────────
// ⑩ bootstrap 下发的菜单
// ─────────────────────────────────────────────────────────────────────────────

describe('⑩ bootstrap 的菜单里有七个框架页面', () => {
  let shop: Shop
  let viewer: { token: string }

  beforeAll(async () => {
    shop = await createShop(12, '菜单')
    viewer = await createStaffWithRole(shop, { phone: phoneFor(91), codes: ['{{domainSlug}}:list'] })
  })

  it('店主看得到全部七个（工作台 / 员工 / 角色 / 账单 / 审计 / 公告 / 个人设置）', async () => {
    const boot = await bootstrapOf(shop.token)
    const keys = menuKeys(boot.menus)
    for (const key of [
      'dashboard',
      'staff',
      'role',
      'billing',
      'audit',
      'announcement',
      'profile',
    ]) {
      expect(keys, `框架页面 ${key} 没有下发——前端那一页会变成 404`).toContain(key)
    }
    // 示例业务模块的菜单还在（新增的框架菜单不该把它挤掉）。
    expect(keys).toContain('{{domainSlug}}.list')
  })

  it('受限员工看不到 staff / role / audit / 个人设置，但工作台与账单还在', async () => {
    const boot = await bootstrapOf(viewer.token)
    const keys = menuKeys(boot.menus)

    expect(keys, '登录后的落地页不受权限裁剪，裁掉它 = 登录进去 404').toContain('dashboard')
    expect(keys, '到期时人人都得看得到「去续费」').toContain('billing')
    expect(keys).toContain('{{domainSlug}}.list')

    for (const key of ['staff', 'role', 'audit', 'announcement', 'profile']) {
      expect(
        keys,
        `${key} 要求一个他没有的权限点，pruneMenus 必须把它裁掉——` +
          '菜单裁剪与守卫判定用的是同一份 granted 集合，所以「看得到但点了 403」不该发生。',
      ).not.toContain(key)
    }
  })

  it('只挂内置 staff 角色模板的员工：看得到「个人设置」与「公告」，看不到 staff / role / audit（缺口 1 的验收标准）', async () => {
    // 建店时 provisionTenant 已经把 BASE_ROLE_PRESETS 实例化成这家店自己的 Role，
    // 内置 `staff` 角色就在里面——不用另建一个自定义角色。
    const staffRole = await prisma.role.findFirst({
      where: { tenantId: shop.tenantId, code: 'staff' },
    })
    if (staffRole === null) {
      throw new Error('provisionTenant 没有下发内置的 staff 角色——role-presets 的 seed 被改坏了？')
    }
    const phone = phoneFor(92)
    const account = await prisma.staffAccount.create({
      data: {
        id: ulid(),
        phone,
        passwordHash: await hashPassword(PASSWORD),
        name: 'E2E 普通员工（内置模板）',
        status: 'ACTIVE',
      },
    })
    await prisma.staff.create({
      data: {
        id: ulid(),
        tenantId: shop.tenantId,
        accountId: account.id,
        name: 'E2E 普通员工（内置模板）',
        status: 'ACTIVE',
        roleIds: [staffRole.id],
        dataScope: 'ALL',
        isOwner: false,
      },
    })
    const session = await login(phone, PASSWORD, shop.tenantId)

    const boot = await bootstrapOf(session.access)
    const keys = menuKeys(boot.menus)

    expect(
      keys,
      '内置 staff 模板含 profile:read/write——员工连自己的资料都看不到，是缺口 1 的症状。',
    ).toContain('profile')
    expect(
      keys,
      '内置 staff 模板含 announcement:list——员工连平台公告都看不到，是缺口 1 的症状。',
    ).toContain('announcement')

    for (const key of ['staff', 'role', 'audit']) {
      expect(
        keys,
        `内置 staff 模板不含对应权限点，${key} 该被裁掉——普通员工不该看得到通讯录/角色配置/审计日志。`,
      ).not.toContain(key)
    }
  })
})
