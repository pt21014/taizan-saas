describe('⑦ 审计日志', () => {
  let shopA: Shop
  let shopB: Shop
  let staffA: { staffId: string }

  beforeAll(async () => {
    shopA = await createShop(7, '审计 A')
    shopB = await createShop(8, '审计 B')
    staffA = await createStaffWithRole(shopA, { phone: phoneFor(71), codes: ['{{domainSlug}}:list'] })

    // A 店做三件会被审计的事。
    await createInvite(shopA)
    await request(http())
      .patch(`/api/admin/staff/${staffA.staffId}`)
      .set('Authorization', `Bearer ${shopA.token}`)
      .send({ name: '改过名的员工' })
    await request(http())
      .post('/api/admin/roles')
      .set('Authorization', `Bearer ${shopA.token}`)
      .send({ code: 'audited', name: '被审计的角色', permissionCodes: [] })

    // B 店也做一件，用来证明 A 看不到它。
    await request(http())
      .post('/api/admin/roles')
      .set('Authorization', `Bearer ${shopB.token}`)
      .send({ code: 'b-only', name: 'B 店独有角色', permissionCodes: [] })
  })

  it('看得到刚才那三个动作', async () => {
    const res = await request(http())
      .get('/api/admin/audit-logs')
      .set('Authorization', `Bearer ${shopA.token}`)
      .expect(200)
    const data = expectOk<{ items: { action: string; actorName: string; result: string }[] }>(
      res.body,
    )
    const actions = data.items.map((i) => i.action)
    expect(actions).toContain('staff.invite')
    expect(actions).toContain('staff.role-change')
    expect(actions).toContain('role.create')
    // 操作者名字是**快照**，不是关联查询：人改名了、删了，日志上仍然是当时那个名字。
    expect(data.items.every((i) => i.actorName.length > 0)).toBe(true)
  })

  it('只含本租户——B 店那条 role.create 在 A 店看不到', async () => {
    const res = await request(http())
      .get('/api/admin/audit-logs')
      .query({ action: 'role.create', pageSize: 200 })
      .set('Authorization', `Bearer ${shopA.token}`)
      .expect(200)
    const items = expectOk<{ items: { targetId: string | null }[] }>(res.body).items

    const bRole = await prisma.role.findFirst({
      where: { tenantId: shopB.tenantId, code: 'b-only' },
      select: { id: true },
    })
    // A 店建了 1 条（`audited`），B 店建了 1 条。租户条件由 `prisma.tenant` 注入，
    // 这个接口一行 `tenantId` 都没写——写了才是隐患。
    expect(items).toHaveLength(1)
    expect(items.map((i) => i.targetId)).not.toContain(bRole?.id)
  })

  it('按模块段筛（`module=staff` 等价于 action LIKE "staff.%"）', async () => {
    const res = await request(http())
      .get('/api/admin/audit-logs')
      .query({ module: 'staff', pageSize: 200 })
      .set('Authorization', `Bearer ${shopA.token}`)
      .expect(200)
    const items = expectOk<{ items: { action: string }[] }>(res.body).items
    expect(items.length).toBeGreaterThanOrEqual(2)
    expect(items.every((i) => i.action.startsWith('staff.'))).toBe(true)
  })
})

