    const role = expectOk<{ id: string; builtin: boolean; staffCount: number }>(created.body)
    createdRoleId = role.id
    expect(role.builtin).toBe(false)
    expect(role.staffCount).toBe(0)

    const list = await request(http())
      .get('/api/admin/roles')
      .query({ keyword: 'cashier' })
      .set('Authorization', `Bearer ${shop.token}`)
      .expect(200)
    expect(expectOk<{ total: number }>(list.body).total).toBe(1)
  })

  it('改角色的权限点 → 挂着它的人**下一个请求就生效**', async () => {
    // 先把人挂到这个角色上。
    expectOk(
      (
        await request(http())
          .patch(`/api/admin/staff/${holder.staffId}`)
          .set('Authorization', `Bearer ${shop.token}`)
          .send({ roleIds: [createdRoleId] })
      ).body,
    )

    const before = await request(http())
      .post('/api/admin/{{domainSlug}}')
      .set('Authorization', `Bearer ${holder.token}`)
      .send({ name: `角色改权限前 ${RUN}`, priceCents: 100 })
    expect(codeOf(before.body)).toBe(1340300)

    expectOk(
      (
        await request(http())
          .patch(`/api/admin/roles/${createdRoleId}`)
          .set('Authorization', `Bearer ${shop.token}`)
          .send({ permissionCodes: ['{{domainSlug}}:list', '{{domainSlug}}:write'] })
      ).body,
    )

    const after = await request(http())
      .post('/api/admin/{{domainSlug}}')
      .set('Authorization', `Bearer ${holder.token}`)
      .send({ name: `角色改权限后 ${RUN}`, priceCents: 100 })
    expectOk<{ {{domainSlug}}: { id: string } }>(after.body)
  })

  it('permissionCodes 里含 platform-* → 1040000', async () => {
    const res = await request(http())
      .post('/api/admin/roles')
      .set('Authorization', `Bearer ${shop.token}`)
      .send({
        code: 'sneaky',
        name: '想偷平台权限的角色',
        permissionCodes: ['{{domainSlug}}:list', 'platform-tenant:list'],
      })
    expect(codeOf(res.body)).toBe(1040000)
    expect(messageOf(res.body)).toContain('platform-tenant:list')
  })

  it('permissionCodes 里含通配 → 1040000（通配会随新增权限点静默放宽）', async () => {
    const res = await request(http())
      .post('/api/admin/roles')
      .set('Authorization', `Bearer ${shop.token}`)
      .send({ code: 'wild', name: '通配角色', permissionCodes: ['{{domainSlug}}:*'] })
    expect(codeOf(res.body)).toBe(1040000)
    expect(messageOf(res.body)).toContain('通配')
  })

  it('permissionCodes 里含未注册的 code → 1040000', async () => {
    const res = await request(http())
      .post('/api/admin/roles')
      .set('Authorization', `Bearer ${shop.token}`)
      .send({ code: 'typo', name: '拼错了的角色', permissionCodes: ['{{domainSlug}}:lst'] })
    expect(codeOf(res.body)).toBe(1040000)
    expect(messageOf(res.body)).toContain('{{domainSlug}}:lst')
  })

  it('内置角色：不能删，也不能改 code（但改名 / 改权限点可以）', async () => {
    const builtin = await prisma.role.findFirst({
      where: { tenantId: shop.tenantId, code: 'manager', deletedAt: null },
      select: { id: true },
    })
    expect(builtin, '建店应当实例化 manager 内置角色').not.toBeNull()
    const id = builtin?.id ?? ''

    const removed = await request(http())
      .delete(`/api/admin/roles/${id}`)
      .set('Authorization', `Bearer ${shop.token}`)
    expect(codeOf(removed.body)).toBe(1040000)
    expect(messageOf(removed.body)).toContain('内置角色')

    const renamedCode = await request(http())
      .patch(`/api/admin/roles/${id}`)
      .set('Authorization', `Bearer ${shop.token}`)
      .send({ code: 'manager-2' })
    expect(codeOf(renamedCode.body)).toBe(1040000)

    const renamed = await request(http())
      .patch(`/api/admin/roles/${id}`)
      .set('Authorization', `Bearer ${shop.token}`)
      .send({ name: '门店店长' })
    expect(expectOk<{ name: string }>(renamed.body).name).toBe('门店店长')
  })

  it('还有人挂着的角色删不掉；把人改走之后就能删了', async () => {
    const blocked = await request(http())
      .delete(`/api/admin/roles/${createdRoleId}`)
