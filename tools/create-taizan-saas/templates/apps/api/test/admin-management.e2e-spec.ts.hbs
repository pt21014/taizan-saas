/** 每次跑用一段唯一后缀，重复跑也不打架。 */
const RUN = ulid().slice(-8).toLowerCase()
const PASSWORD = 'e2e-password-123'

/**
 * 手机号池：`136` + 本次运行的 6 位数字化后缀 + 2 位序号 = **恰好 11 位**。
 *
 * 位数是硬约束（DTO 上是 `/^1\d{10}$/`，多一位少一位都会被拦成 1040000），
 * 所以序号补零而不是直接拼。前缀用 `136` 与 `rbac-billing.e2e-spec.ts` 的 `137` 错开，
 * 两份 e2e 在同一个库上跑时不会撞 `StaffAccount.phone` 的全局唯一键。
 */
const PHONE_BASE = [...RUN]
  .map((c) => c.charCodeAt(0) % 10)
  .join('')
  .slice(0, 6)

function phoneFor(n: number): string {
  return `136${PHONE_BASE}${String(n).padStart(2, '0')}`
}

/** 从任意字符串种子派生一个伪客户端 IP。见文件头「伪 X-Forwarded-For」。 */
function fakeClientIp(seed: string): string {
  const codes = [...seed].map((c) => c.charCodeAt(0))
  const octet = (offset: number): number => {
    const sum = codes.reduce((acc, code, i) => acc + code * (i + offset + 1), 0)
    return (sum % 254) + 1 // 1..254，避开 0（非法段）与 255
  }
  return `10.${octet(1)}.${octet(2)}.${octet(3)}`
}

let app: INestApplication
let prisma: PrismaClient
let gateway: PlatformGateway
let platformToken = ''

function http(): Parameters<typeof request>[0] {
  return app.getHttpServer() as Parameters<typeof request>[0]
}

/** 成功响应的信封形状；`code` 不为 0 时直接把整个 body 打出来，省得反复加日志。 */
function expectOk<T>(body: unknown): T {
  const envelope = body as { code: number; message: string; data: T }
  expect(envelope.code, `期望 code=0，实际：${JSON.stringify(envelope)}`).toBe(0)
  return envelope.data
}

/** 取业务码。 */
function codeOf(body: unknown): number {
  return (body as { code: number }).code
}

/** 取错误文案。 */
function messageOf(body: unknown): string {
  return (body as { message: string }).message
}

interface Shop {
  tenantId: string
  slug: string
  /** 店主 token。 */
  token: string
  /** 店主的 `Staff.id`。 */
  staffId: string
  ownerPhone: string
}

/** 用平台 token 开一家店并以店主身份登录。不传 `planId` = 这家店没有套餐（不限量、全功能）。 */
async function createShop(index: number, label: string): Promise<Shop> {
  const slug = `e2e-am-${index}-${RUN}`
  const phone = phoneFor(index)
  const created = await request(http())
    .post('/api/platform/tenants')
    .set('Authorization', `Bearer ${platformToken}`)
    .send({
      slug,
      name: `E2E 管理面 ${label} ${RUN}`,
      ownerPhone: phone,
      ownerPassword: PASSWORD,
      trialDays: 30,
    })
  const data = expectOk<{ tenant: { id: string; slug: string } }>(created.body)
  const session = await login(phone, PASSWORD, data.tenant.id)
  return {
    tenantId: data.tenant.id,
    slug: data.tenant.slug,
    token: session.access,
    staffId: session.staffId,
    ownerPhone: phone,
  }
}

/** 商家登录。每次一个独立的限流桶。 */
async function login(
  phone: string,
  password: string,
  tenantId: string,
): Promise<{ access: string; staffId: string }> {
  const res = await request(http())
    .post('/api/admin/auth/login')
    .set('X-Forwarded-For', fakeClientIp(`${phone}-${password}-${tenantId}`))
    .send({ phone, password, tenantId })
  return expectOk<{ access: string; staffId: string }>(res.body)
}

/**
 * 直接写库造一个带角色的员工，再登录拿 token。
 *
 * 走库而不是走「邀请 → 核销」那条真实路径，是因为大多数用例要的只是「一个权限受限的
 * 身份」，而核销那条路每次都会消耗一格 `signup` 档限流额度（24 小时窗口）。
 * 邀请路径本身由用例组①②专门验证。
 */
async function createStaffWithRole(
  shop: Shop,
  spec: { phone: string; codes: string[]; name?: string },
): Promise<{ token: string; staffId: string; roleId: string; accountId: string }> {
  const role = await prisma.role.create({
    data: {
      id: ulid(),
      tenantId: shop.tenantId,
      code: `e2e-role-${ulid().slice(-6).toLowerCase()}`,
      name: 'E2E 受限角色',
      permissionCodes: spec.codes,
      builtin: false,
    },
  })
  const account = await prisma.staffAccount.create({
    data: {
      id: ulid(),
      phone: spec.phone,
      passwordHash: await hashPassword(PASSWORD),
      name: spec.name ?? 'E2E 员工',
      status: 'ACTIVE',
    },
  })
  const staff = await prisma.staff.create({
    data: {
      id: ulid(),
      tenantId: shop.tenantId,
      accountId: account.id,
      name: spec.name ?? 'E2E 员工',
      status: 'ACTIVE',
      roleIds: [role.id],
      dataScope: 'ALL',
      isOwner: false,
    },
  })
  const session = await login(spec.phone, PASSWORD, shop.tenantId)
  return {
    token: session.access,
    staffId: staff.id,
    roleId: role.id,
    accountId: account.id,
  }
}

/** 建一档套餐（平台域表，直接写库——套餐管理是另一条工作流）。 */
async function createPlan(spec: {
  code?: string
  features?: string[] | null
  quotas: Record<string, number | null>
}): Promise<{ id: string; code: string }> {
  const code = spec.code ?? `e2e-am-plan-${ulid().slice(-8).toLowerCase()}`
  const plan = await prisma.plan.create({
    data: {
      id: ulid(),
      code,
      name: 'E2E 管理面套餐',
      firstPriceCents: 0,
      renewPriceCents: 0,
      periodMonths: 1,
      quotas: spec.quotas,
      // `undefined` = 不写这一列 = `null` = 全部功能可用。传 `[]` 是「一个都不给」，
      // 那会让这些用例先撞上 1540302，测的就不是配额了。
      features: spec.features == null ? undefined : spec.features,
      appKeys: ['admin', 'client'],
      trafficMb: 0,
    },
  })
  return { id: plan.id, code: plan.code }
}

/**
 * 改一家店的闸门相关字段，然后**必须** `invalidate`。
 *
 * 不 invalidate 的话闸门视图还在 30 秒缓存里，改了跟没改一样。
 */
async function mutateTenant(tenantId: string, data: Record<string, unknown>): Promise<void> {
  await prisma.tenant.update({ where: { id: tenantId }, data })
  gateway.invalidate(tenantId)
}

/** 取 bootstrap。 */
async function bootstrapOf(token: string): Promise<{
  permissions: string[]
  menus: MenuNode[]
  identity: { name: string; isOwner: boolean }
  quotas: Record<string, { used: number; limit: number | null }>
}> {
  const res = await request(http())
    .get('/api/admin/auth/bootstrap')
    .set('Authorization', `Bearer ${token}`)
    .expect(200)
  return expectOk(res.body)
}

/** 把菜单树摊平成 key 列表。 */
function menuKeys(menus: readonly MenuNode[]): string[] {
  return menus.flatMap((node) => [node.key, ...menuKeys(node.children ?? [])])
}

/** 生成一张邀请。 */
async function createInvite(
  shop: Shop,
  body: { phone?: string; roleIds?: string[] } = {},
): Promise<{ token: string; acceptPath: string; id: string }> {
  const res = await request(http())
    .post('/api/admin/staff/invites')
    .set('Authorization', `Bearer ${shop.token}`)
    .send({ roleIds: body.roleIds ?? [], ...(body.phone ? { phone: body.phone } : {}) })
  return expectOk(res.body)
}

/** 核销一张邀请。**每次一个独立的限流桶**（`signup` 档，成功也计数）。 */
function acceptInvite(token: string, phone: string, password = PASSWORD): request.Test {
  return request(http())
    .post(`/api/public/invites/${token}/accept`)
    .set('X-Forwarded-For', fakeClientIp(`accept-${token}-${phone}`))
    .send({ phone, password })
}

