    expect(codeOf(res.body)).toBe(1040000)
    expect(messageOf(res.body)).toContain('指定手机号')
  })

  it('STAFF 配额为 0 时核销 → 1540301，且库里没有多出员工', async () => {
    const plan = await createPlan({ quotas: { STAFF: 0 } })
    await mutateTenant(shop.tenantId, {
      planId: plan.id,
      status: 'ACTIVE',
      planExpireAt: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000),
      trialEndAt: null,
    })

    const before = await prisma.staff.count({ where: { tenantId: shop.tenantId } })
    const invite = await createInvite(shop)
    const res = await acceptInvite(invite.token, phoneFor(25))

    expect(
      codeOf(res.body),
      '1540301（升套餐）与 1440301（续费）必须分开：合成一个笼统的「无权限」，商家只会来问客服。',
    ).toBe(1540301)
