beforeAll(async () => {
  prisma = new PrismaClient()
  await seedBase(
    {
      platformAdmin: prisma.platformAdmin,
      plan: prisma.plan,
      tenant: prisma.tenant,
      staffAccount: prisma.staffAccount,
      staff: findFirstUpsertDelegate(prisma.staff),
      role: findFirstUpsertDelegate(prisma.role),
      rolePreset: prisma.rolePreset,
    },
    { withDemoTenant: false },
  )

  const moduleRef = await Test.createTestingModule({ imports: [AppModule] }).compile()
  app = moduleRef.createNestApplication({ logger: false })
  configureApp(app)
  await app.init()
  gateway = app.get<PlatformGateway>(PLATFORM_GATEWAY)

  const res = await request(http())
    .post('/api/platform/auth/login')
    .set('X-Forwarded-For', fakeClientIp(`platform-admin-${RUN}`))
    .send({ username: 'admin', password: 'admin123' })
  platformToken = expectOk<{ access: string }>(res.body).access
})

/**
 * 收尾：把本次运行造出来的**平台域**数据删掉。
 *
 * 租户域的东西（店、员工、角色、商品）留着不管——它们带着 `RUN` 后缀、彼此隔离，
 * 而且租户隔离扩展保证下一轮跑不会看见它们。
 *
 * 但 `Plan` 与 `Announcement` 是**平台域**表，没有租户维度，攒下来会真的影响别人：
 *
 * - `platform.e2e-spec.ts` 有一条「`GET /api/platform/plans?pageSize=200` 里能查到刚建的套餐」，
 *   开发库里的 e2e 套餐一旦攒过 200 条，那一条就会**因为分页而不是因为 bug** 变红；
 * - 本文件的公告可见性用例读的是「已发布 + 在有效期内」的前 500 条候选
 *   （`AdminAnnouncementService` 的 `CANDIDATE_LIMIT`），攒多了同样会被截断。
 *
 * 「测试自己造的平台域数据自己收」是唯一能长期成立的规则——指望定期手工清库
 * 等于指望有人记得，而那件事在实践中约等于不会发生。
 */
afterAll(async () => {
  await app?.close()

  if (prisma) {
    // 公告：按本次运行的后缀认领。
    await prisma.announcement
      .deleteMany({ where: { title: { contains: RUN } } })
      .catch(() => undefined)
    // 套餐：先把挂着它的店解绑（`Tenant.planId` 上没有外键，但留一个指向已删套餐的
    // id 会让闸门视图算不出 planCode，下一次跑到这些店上时行为会很怪）。
    const plans = await prisma.plan
      .findMany({ where: { code: { startsWith: 'e2e-am-plan-' } }, select: { id: true } })
      .catch(() => [])
    if (plans.length > 0) {
      const ids = plans.map((x) => x.id)
      await prisma.tenant
        .updateMany({ where: { planId: { in: ids } }, data: { planId: null } })
        .catch(() => undefined)
      await prisma.plan.deleteMany({ where: { id: { in: ids } } }).catch(() => undefined)
    }
  }

  await prisma?.$disconnect()
})

// ─────────────────────────────────────────────────────────────────────────────
// ① 员工列表与邀请
// ─────────────────────────────────────────────────────────────────────────────

describe('① 员工列表与邀请 → 核销 → 新员工能登录', () => {
  let shop: Shop
  let invite: { token: string; acceptPath: string }
  const newbiePhone = phoneFor(11)
  /**
   * 建店那一刻 `STAFF` 配额的基线。
   *
   * **不是 0**：`@taizan/provision` 开通租户时会给店主本人扣一格
   * （店主也是一个 `Staff` 行）。写死 0 的断言会红，而红的原因与「邀请扣没扣配额」
   * 毫无关系——所以这里取实测基线，只断言**增量**。
   */
  let staffQuotaBaseline = 0

  beforeAll(async () => {
    shop = await createShop(1, '员工')
  })

  it('店主看得到员工列表，自己是 isOwner 且带着登录手机号', async () => {
    const res = await request(http())
      .get('/api/admin/staff')
      .set('Authorization', `Bearer ${shop.token}`)
      .expect(200)
    const data = expectOk<{
      total: number
      items: { id: string; isOwner: boolean; phone: string; roleNames: string[] }[]
    }>(res.body)

    expect(data.total).toBe(1)
    const owner = data.items[0]
    expect(owner?.id).toBe(shop.staffId)
    expect(owner?.isOwner).toBe(true)
    // 手机号在 **StaffAccount**（平台域表）上，列表要跨过去取——取不到会是空串。
    expect(owner?.phone).toBe(shop.ownerPhone)
  })

  it('按手机号关键字能搜到（关键字同时匹配店内昵称与手机号）', async () => {
    const res = await request(http())
      .get('/api/admin/staff')
      .query({ keyword: shop.ownerPhone.slice(-6) })
      .set('Authorization', `Bearer ${shop.token}`)
      .expect(200)
    expect(expectOk<{ total: number }>(res.body).total).toBe(1)
  })

  it('生成邀请**不扣配额**（人没来之前不占名额）', async () => {
    const before = await bootstrapOf(shop.token)
    staffQuotaBaseline = before.quotas.STAFF?.used ?? 0
    expect(staffQuotaBaseline, '店主自己占一格').toBe(1)

    invite = await createInvite(shop)
    expect(invite.token.length).toBeGreaterThanOrEqual(24)
    expect(invite.acceptPath).toBe(`/api/public/invites/${invite.token}`)

    const after = await bootstrapOf(shop.token)
    expect(
      after.quotas.STAFF?.used,
      '发了 10 张没人用的邀请就把配额占死，那需要一个「撤销邀请」动作来释放——又一条要维护的路径。',
    ).toBe(staffQuotaBaseline)
  })

  it('GET /api/public/invites/:token 免登录查得到（有效 + 店名）', async () => {
    const res = await request(http())
      .get(`/api/public/invites/${invite.token}`)
      .set('X-Forwarded-For', fakeClientIp(`lookup-ok-${RUN}`))
      .expect(200)
    const data = expectOk<{ valid: boolean; shopName: string | null; phoneMask: string | null }>(
      res.body,
    )
    expect(data.valid).toBe(true)
    expect(data.shopName).toContain('E2E 管理面')
    expect(data.phoneMask, '这张邀请不限手机号').toBeNull()
  })

  it('乱猜的 token 回 200 + valid:false，且**不下发店名**', async () => {
    const res = await request(http())
      .get(`/api/public/invites/no-such-token-${RUN}`)
      .set('X-Forwarded-For', fakeClientIp(`lookup-bad-${RUN}`))
      .expect(200)
    const data = expectOk<{ valid: boolean; reason: string; shopName: string | null }>(res.body)
    expect(data.valid).toBe(false)
    expect(data.reason).toBe('NOT_FOUND')
    expect(data.shopName, '连店名都下发的话，乱猜令牌就能把平台上的店名单抄走').toBeNull()
  })

  it('核销成功：建出 Staff，且**响应里没有 token**', async () => {
    const res = await acceptInvite(invite.token, newbiePhone)
    const data = expectOk<Record<string, unknown>>(res.body)
    expect(data.staffId).toBeTruthy()
    expect(data.tenantId).toBe(shop.tenantId)
    expect(data.loggedIn).toBe(false)
    expect(
      Object.keys(data),
      '在这里签 token 等于开了第二条进后台的路，而登录接口上的限流与停用判定这里一条都没有。',
    ).not.toContain('access')
  })

  it('新员工能用手机号 + 密码正常登录，并且出现在员工列表里', async () => {
    const session = await login(newbiePhone, PASSWORD, shop.tenantId)
    expect(session.access).toBeTruthy()

    const res = await request(http())
      .get('/api/admin/staff')
      .set('Authorization', `Bearer ${shop.token}`)
      .expect(200)
    const data = expectOk<{ total: number; items: { phone: string }[] }>(res.body)
    expect(data.total).toBe(2)
    expect(data.items.map((s) => s.phone)).toContain(newbiePhone)
  })

  it('核销之后 STAFF 配额计数 +1（配额扣在这一刻，不在发邀请时）', async () => {
    const after = await bootstrapOf(shop.token)
    expect(after.quotas.STAFF?.used).toBe(staffQuotaBaseline + 1)
  })
})

// ─────────────────────────────────────────────────────────────────────────────
// ② 邀请的边界
// ─────────────────────────────────────────────────────────────────────────────

describe('② 邀请的边界：重复核销 / 配额用尽 / 手机号不符', () => {
  let shop: Shop

  beforeAll(async () => {
    shop = await createShop(2, '邀请边界')
  })

  it('同一张邀请核销两次：第二次 1040000（一次性核销）', async () => {
    const invite = await createInvite(shop)
    expectOk(await acceptInvite(invite.token, phoneFor(21)).then((r) => r.body))

    const again = await acceptInvite(invite.token, phoneFor(22))
    expect(codeOf(again.body)).toBe(1040000)
