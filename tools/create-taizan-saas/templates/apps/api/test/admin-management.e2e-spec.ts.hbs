describe('⑤ 转让店主', () => {
  let shop: Shop
  let heir: { token: string; staffId: string }
  /** 一个**带着 staff:transfer-owner 权限点**的非店主：用来证明服务层还有第二道判定。 */
  let pretender: { token: string; staffId: string }

  beforeAll(async () => {
    shop = await createShop(5, '转让')
    heir = await createStaffWithRole(shop, {
      phone: phoneFor(51),
      codes: ['{{domainSlug}}:list'],
      name: 'E2E 接班人',
    })
    pretender = await createStaffWithRole(shop, {
      phone: phoneFor(52),
      codes: ['staff:list', 'staff:transfer-owner'],
    })
  })

  it('非店主即使被授予了 staff:transfer-owner，服务层照样拒（1340300）', async () => {
    const res = await request(http())
      .post('/api/admin/staff/transfer-owner')
      .set('Authorization', `Bearer ${pretender.token}`)
      .send({ staffId: heir.staffId })
    expect(
      codeOf(res.body),
      '权限点是「能不能看见这个按钮」，principal.isOwner 才是「真的按下去时」。',
    ).toBe(1340300)
  })

  it('店主转让成功：接班人 isOwner，自己降为内置角色', async () => {
    const res = await request(http())
      .post('/api/admin/staff/transfer-owner')
      .set('Authorization', `Bearer ${shop.token}`)
      .send({ staffId: heir.staffId })
    const data = expectOk<{
      newOwnerStaffId: string
      previousOwnerStaffId: string
      demotedToRoleId: string | null
    }>(res.body)

    expect(data.newOwnerStaffId).toBe(heir.staffId)
    expect(data.previousOwnerStaffId).toBe(shop.staffId)
    expect(data.demotedToRoleId, '本店应当有 manager / staff 内置角色可降').not.toBeNull()

    const rows = await prisma.staff.findMany({
      where: { tenantId: shop.tenantId, isOwner: true },
      select: { id: true },
    })
    expect(
      rows.map((r) => r.id),
      '全店只能有一个店主',
    ).toEqual([heir.staffId])
  })

  it('原店主立刻失去 OWNER-only 能力（再转一次 → 1340300）', async () => {
    const res = await request(http())
      .post('/api/admin/staff/transfer-owner')
      .set('Authorization', `Bearer ${shop.token}`)
      .send({ staffId: pretender.staffId })
    expect(codeOf(res.body)).toBe(1340300)
  })

  it('原店主的 bootstrap 不再是全量权限，新店主是', async () => {
    const previous = await bootstrapOf(shop.token)
    const now = await bootstrapOf(heir.token)
    expect(previous.identity.isOwner).toBe(false)
    expect(now.identity.isOwner).toBe(true)
    expect(now.permissions.length).toBeGreaterThan(previous.permissions.length)
  })
})

