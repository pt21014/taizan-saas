{
  "name": "{{scope}}/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "{{projectName}} 唯一后端进程：NestJS 11 模块化单体，三命名空间（/api/platform、/api/admin、/api/client）+ /api/public。装配 @{{projectSlug}}/* 全部框架包，示例业务模块 example-{{domainSlug}} 贯穿七个扩展点。",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/bootstrap/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "pnpm run taizan:schema-sync && prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "retention": "tsx src/modules/platform/plan-lifecycle/retention.cli.ts",
    "taizan:schema-sync": "taizan-schema-sync prisma/schema",
    "taizan:schema-check": "taizan-schema-sync prisma/schema --check",
    "taizan:verify-schema": "taizan-verify-schema prisma/schema --registered={{DomainPascal}},{{DomainPascal}}Sku",
    "taizan:env-example": "tsx scripts/gen-env-example.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "@taizan/billing-rules": "^0.1.0",
    "@taizan/contracts": "^0.1.0",
    "@taizan/crypto": "^0.1.0",
    "@taizan/nest-audit": "^0.1.0",
    "@taizan/nest-auth": "^0.1.0",
    "@taizan/nest-billing": "^0.1.0",
    "@taizan/nest-core": "^0.1.0",
    "@taizan/nest-infra": "^0.1.0",
    "@taizan/nest-notify": "^0.1.0",
    "@taizan/nest-payment": "^0.1.0",
    "@taizan/nest-prisma": "^0.1.0",
    "@taizan/nest-rbac": "^0.1.0",
    "@taizan/payment-core": "^0.1.0",
    "@taizan/prisma-base": "^0.1.0",
    "@taizan/provision": "^0.1.0",
    "@taizan/ratelimit-core": "^0.1.0",
    "@taizan/rbac-core": "^0.1.0",
    "@taizan/sms": "^0.1.0",
    "@taizan/tenant-scope": "^0.1.0",
    "@taizan/wechatpay": "^0.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "{{scope}}/eslint-config": "workspace:*",
    "{{scope}}/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "@nestjs/testing": "^11.2.3"
  }
}
