/**
 * `GET /api/client/{{domainSlug}}` —— C 端{{domainName}}列表。
 *
 * 它在 T0-8 存在的理由只有一个：**证明 C 端也真的被隔离住了**。
 * e2e 用例⑨拿 A 店会员的 token 请求它，并且在请求头里塞 B 店的 slug——
 * 结果必须仍然只看得到 A 店的{{domainName}}，因为 `TokenTenantResolver` 排在解析链首位，
 * 它一旦命中，`SlugHeaderResolver` 根本不会被调用。
 *
 * `@Auth('member')`：只接受会员 token。staff token 打过来是 1140102。
 * 真实项目里 C 端{{domainName}}列表通常是 `@Public()` 的（逛店不用登录），
 * 这里刻意要求登录，是为了让「token 里的租户压过请求头里的租户」这条不变量能被断言。
 *
 * @packageDocumentation
 */

import { Controller, Get, Inject, Query } from '@nestjs/common'
import { ApiHeader, ApiOperation, ApiTags } from '@nestjs/swagger'
import type { PageResult } from '@taizan/contracts'
import { Auth, TENANT_SLUG_HEADER } from '@taizan/nest-auth'

import { Validate } from '../../../common/validate.pipe'
import { List{{DomainPascal}}QueryDto, type {{DomainPascal}}View } from '../../example-{{domainSlug}}/dto/{{domainSlug}}.dto'
import { {{DomainPascal}}Service } from '../../example-{{domainSlug}}/{{domainSlug}}.service'

@ApiTags('client/{{domainSlug}}')
@Controller('api/client/{{domainSlug}}')
@Auth('member')
@ApiHeader({ name: TENANT_SLUG_HEADER, description: '店铺 slug（已登录时以 token 里的店为准）' })
export class Client{{DomainPascal}}Controller {
  // 复用商家侧的 {{DomainPascal}}Service 而不是另写一份查询：两份「一样的」读逻辑会慢慢走偏，
  // 而走偏的方向通常是 C 端那份忘了过滤下架{{domainName}}。
  constructor(@Inject({{DomainPascal}}Service) private readonly {{domainSlug}}: {{DomainPascal}}Service) {}

  @Get()
  @ApiOperation({ summary: 'C 端{{domainName}}列表（只看得到自己店的）' })
  list(
    @Query(Validate(List{{DomainPascal}}QueryDto)) query: List{{DomainPascal}}QueryDto,
  ): Promise<PageResult<{{DomainPascal}}View>> {
    // C 端只该看到已上架的。状态由服务端写死，不接受前端传——
    // 否则 `?status=DRAFT` 就能看到别人还没发布的{{domainName}}。
    return this.{{domainSlug}}.list({ page: query.page, pageSize: query.pageSize, status: 'ON_SHELF' })
  }
}
