/**
 * 蓝图 §7 扩展点④ **注册菜单**：模块内定义，`src/registry/menus.ts` 汇总。
 *
 * 每个 `MENU` 节点带两个裁剪依据：
 * - `permission`：这个人的角色里有没有这个权限点；
 * - `featureKey`：这家店的套餐里有没有这个功能项。
 *
 * 两者是「与」的关系，缺一个菜单就不下发。`componentKey` 只是一个 key，
 * 服务端不知道也不该知道前端的文件路径——`apps/admin/src/routes/component-map.ts`
 * 负责把 key 映射到组件，由 `menu-route-map.spec.ts`（spec 7）双向比对。
 *
 * @packageDocumentation
 */

import { type MenuDef } from '@taizan/contracts'

/** {{name}}模块的菜单。 */
export const {{CONST}}_MENUS: readonly MenuDef[] = [
  {
    key: '{{slug}}',
    title: '{{name}}',
    icon: 'AppstoreOutlined',
    type: 'DIR',
    side: 'ADMIN',
    sort: {{menuSort}},
    children: [
      {
        key: '{{slug}}.list',
        title: '{{name}}列表',
        path: '/{{slug}}',
        componentKey: '{{componentKey}}',
        type: 'MENU',
        side: 'ADMIN',
        permission: '{{slug}}:list',
        featureKey: '{{slug}}',
        sort: 10,
      },
      {
        // 按钮级菜单项：前端据它决定「新增」按钮画不画。
        //
        // 它是 `{{slug}}` 目录的**兄弟节点**而不是 `{{slug}}.list` 的子节点——
        // `defineMenus()` 明令「非 DIR 类型不能有 children」。按钮和它所在的页面
        // 在树上是平级的，靠 key 的前缀（`{{slug}}.*`）表达归属。
        key: '{{slug}}.create',
        title: '新增{{name}}',
        type: 'BUTTON',
        side: 'ADMIN',
        permission: '{{slug}}:write',
        featureKey: '{{slug}}',
        sort: 20,
      },
    ],
  },
]
