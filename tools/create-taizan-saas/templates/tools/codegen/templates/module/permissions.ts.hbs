/**
 * 蓝图 §7 扩展点③ **注册权限点**：模块内定义，`src/registry/permissions.ts` 汇总。
 *
 * 权限点定义在模块目录里而不是集中在注册表文件里，是为了「删掉一个模块 = 删一个目录」。
 * 集中定义的话，删模块时总会留下几个没人再引用的死权限，而死权限在角色配置页上
 * 看起来和活的一模一样。
 *
 * 读 / 写 / 删分三档而不是一个 `{{slug}}:manage`：合成一个之后，
 * 「让新来的实习生能改但不能删」这种再普通不过的诉求就没法表达，
 * 而运营的应对一定是把那个大权限直接给出去。
 *
 * @packageDocumentation
 */

import { definePermissions } from '@taizan/contracts'

/** {{name}}模块的权限点。 */
export const {{CONST}}_PERMISSIONS = definePermissions({
  '{{slug}}:list': { module: '{{name}}', name: '查看{{name}}', type: 'API' },
  '{{slug}}:write': { module: '{{name}}', name: '新增/编辑{{name}}', type: 'API' },
  '{{slug}}:delete': { module: '{{name}}', name: '删除{{name}}', type: 'API' },
  '{{slug}}:export': { module: '{{name}}', name: '导出{{name}}', type: 'BUTTON' },
})
