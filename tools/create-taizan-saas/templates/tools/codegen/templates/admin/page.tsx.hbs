import { Button, Form, Input, InputNumber, Select } from 'antd'
import { DownloadOutlined } from '@ant-design/icons'
import {
  CrudDrawerForm,
  CrudTable,
  Perm,
  dateTimeColumn,
  moneyColumn,
  statusTagColumn,
  useCrudForm,
  useCrudTable,
} from '@taizan/admin-ui'
import { {{CONST}}_STATUS, use{{Pascal}}Api, type {{Pascal}}, type {{Pascal}}Input } from '../../api/{{slug}}'

/** 触发浏览器下载一个 JSON 文件——导出不需要专门的后端「生成文件」接口。 */
function downloadJson(filename: string, rows: unknown): void {
  const blob = new Blob([JSON.stringify(rows, null, 2)], { type: 'application/json' })
  const url = URL.createObjectURL(blob)
  const link = document.createElement('a')
  link.href = url
  link.download = filename
  link.click()
  URL.revokeObjectURL(url)
}

/** 抽成常量而不是行内对象字面量：行内的话每次渲染都是新对象，antd 会当成变化了。 */
const FULL_WIDTH = { width: '100%' } as const

const STATUS_OPTIONS = [
  { label: '草稿', value: 'DRAFT' },
  { label: '启用中', value: 'ACTIVE' },
  { label: '已归档', value: 'ARCHIVED' },
]

/** {{name}}列表：增删改查 + 搜索 + 分页 + 按钮权限 + 只读闸门，一步不多。 */
export default function {{componentKey}}Page() {
  const api = use{{Pascal}}Api()
  const table = useCrudTable<{{Pascal}}>({
    list: api.list,
    remove: api.remove,
    rowKey: 'id',
    syncUrl: true,
    searchSchema: [{ name: 'keyword', label: '名称' }],
  })
  const form = useCrudForm<{{Pascal}}Input>({
    get: api.get,
    create: api.create,
    update: api.update,
    onSuccess: table.refresh,
  })

  const onExport = () => void api.exportAll().then((rows) => downloadJson('{{slug}}.json', rows))

  // 抽成变量而不是写在 JSX 属性里：`create` 的值是个对象字面量，写在属性里就是
  // 一对相邻花括号（表达式容器套对象），读起来永远要停一下。
  const createButton = {
    label: '新增{{name}}',
    perm: '{{slug}}:write',
    onClick: () => form.openForm(),
  }

  const nameRules = [{ required: true, message: '请填名称' }]

  return (
    <>
      <CrudTable<{{Pascal}}>
        table={table}
        title="{{name}}"
        create={createButton}
        toolbar={
          <Perm code="{{slug}}:export">
            <Button icon={<DownloadOutlined />} onClick={onExport}>
              导出
            </Button>
          </Perm>
        }
        columns={[
          { title: '名称', dataIndex: 'name', key: 'name' },
          moneyColumn({ title: '金额', dataIndex: 'priceCents', sorter: true }),
          statusTagColumn({ title: '状态', dataIndex: 'status', map: {{CONST}}_STATUS }),
          dateTimeColumn({ title: '创建时间', dataIndex: 'createdAt' }),
        ]}
        actions={[
          { key: 'edit', label: '编辑', perm: '{{slug}}:write', onClick: (r) => form.openForm(r.id) },
          {
            key: 'del',
            label: '删除',
            perm: '{{slug}}:delete',
            danger: true,
            confirm: (r) => '确定删除「' + r.name + '」？',
            onClick: (r) => void table.removeRow(r),
          },
        ]}
      />
      <CrudDrawerForm form={form} title="{{name}}">
        <Form.Item name="name" label="名称" rules={nameRules}>
          <Input placeholder="给这条{{name}}起个名字" />
        </Form.Item>
        <Form.Item name="priceCents" label="金额（分）" initialValue={0}>
          <InputNumber min={0} precision={0} style={FULL_WIDTH} />
        </Form.Item>
        <Form.Item name="status" label="状态" initialValue="DRAFT">
          <Select options={STATUS_OPTIONS} />
        </Form.Item>
        <Form.Item name="remark" label="备注">
          <Input.TextArea rows={3} maxLength={500} showCount />
        </Form.Item>
      </CrudDrawerForm>
    </>
  )
}
