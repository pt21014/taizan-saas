# 通用安全响应头。
#
# 宝塔面板放置位置：面板本身不提供"snippet 目录 + include"的图形化入口，
# 两种接入方式二选一：
#   A（推荐，改一处全站生效）：把本文件上传到
#     /www/server/panel/vhost/nginx/{{projectName}}-snippets/security-headers.conf，
#     然后在每个站点"配置文件"里的 server{} 块内加一行：
#       include /www/server/panel/vhost/nginx/{{projectName}}-snippets/security-headers.conf;
#   B（不想额外传文件）：直接把下面的 add_header 整段复制粘贴进每个站点的配置文件。
# 本目录下 admin.conf / platform.conf / site.conf / client.conf / api.conf
# 都按方式 A 写了 include 那一行，图省事就用方式 B 替换掉那一行。
#
# 没有用 helmet 的等价物完全覆盖到 nginx 层，是因为 apps/api 已经用
# `@taizan/nest-core` 的 `applyHelmet()` 在应用层加了一份——这里只覆盖
# **静态站点**（admin/platform/site/client 这几个 SPA 没有 Node 进程可以挂 helmet）。

add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
# 静态站点这几个是纯前端 SPA，不内嵌第三方脚本，先给个保守但不至于打断微信 JS-SDK /
# 支付 SDK 内联脚本的策略；真收紧到逐域名白名单属于各 app 自己的产品需求，这里只给底线。
add_header X-XSS-Protection "1; mode=block" always;
