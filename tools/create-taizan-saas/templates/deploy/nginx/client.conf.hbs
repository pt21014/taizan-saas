# C 端静态站点（*.{{rootDomain}}，一份 H5 构建服务全部租户）——apps/client 的 Taro
# `build:h5` 产物。这份跟 admin/platform/site 三份的关键差异是**多租户共用一份静态
# 产物**：`server_name` 用泛域名匹配，具体是哪家店由后端在应用层解析（子域名或
# X-Tenant-Slug 头，见蓝图 §4.1 与 apps/api 的 `SubdomainResolver`），nginx 只需要
# 原样把 `Host` 转发给后端，不用在这一层做任何"按租户分流"的事——分流逻辑只应该
# 存在一处，多一处（nginx 也做一次判断）就是两处可能对不上的隔离逻辑。
#
# 宝塔面板放置位置：面板 → 网站 → 添加站点，`server_name` 填泛域名（例如
# `*.shop.{{rootDomain}}`，需要通配符证书）→ 站点根目录指到 apps/client 的 H5 构建
# 产物部署目录（`pnpm --filter {{scope}}/client build:h5` 或
# `deploy/docker/Dockerfile.web --build-arg APP=client --build-arg BUILD_SCRIPT=build:h5`
# 的产物）→ 该站点 → 设置 → 配置文件，整体替换成本文件内容。
#
# 单租户单独域名部署（不用子域名方案）时，把 `server_name` 换成具体域名即可，
# 其余不用改——后端的 `TenantResolver` 链会按配置的优先级依次尝试子域名/Header/
# token，某一种解析不出来会自动跳到下一种，不是"只能二选一"。
#
# 本文件写于 apps/client 静态 web 产物尚未接入部署流程之前，按标准
# Taro H5（`dist/build/h5/`）产物形状预先写好。

server {
    listen 80;
    listen 443 ssl;
    http2 on;
    server_name *.{{rootDomain}};
    root /www/wwwroot/client.{{rootDomain}};
    index index.html;

    ssl_certificate     /www/server/panel/vhost/cert/client.{{rootDomain}}/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/client.{{rootDomain}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    error_page 497 https://$host$request_uri;

    include /www/server/panel/vhost/nginx/{{projectName}}-snippets/security-headers.conf;
    include /www/server/panel/vhost/nginx/{{projectName}}-snippets/gzip.conf;

    # 同源反代：`/api/client/*` 未登录时靠 `X-Tenant-Slug` 或子域名选店（token 存在
    # 时 token 里的租户压过一切，见 apps/api/README.md「三条必须知道的规则」第 3 条）。
    # `Host` 必须原样转发（下面已经是默认行为，写出来是为了不被后来者改掉）——
    # 后端的子域名解析策略读的就是这个头，改了它多租户分流直接失效。
    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 同 api.conf：缺了这一行，限流会把所有访客算成同一个人；C 端验证码/登录
        # 接口的限流尤其依赖这一行——这里是攻击者最容易批量注册小号的入口。
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Trace-Id $http_x_trace_id;
        proxy_read_timeout 60s;
        proxy_pass http://127.0.0.1:{{apiPort}};
    }

    location = /health {
        access_log off;
        proxy_pass http://127.0.0.1:{{apiPort}};
        proxy_set_header Host $host;
    }

    include /www/server/panel/vhost/nginx/{{projectName}}-snippets/spa.conf;

    access_log /www/wwwlogs/client.{{rootDomain}}.log;
    error_log  /www/wwwlogs/client.{{rootDomain}}.error.log;
}
