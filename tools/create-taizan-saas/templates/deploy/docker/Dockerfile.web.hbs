# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
# 四端共用的静态站点镜像：admin / platform / site 三选一（`client` 的 H5 产物走
# 同样的形状，也可以用本文件，但 client 是 Taro 工程，构建命令是 `build:h5`，
# 用 --build-arg BUILD_SCRIPT=build:h5 覆盖即可）。
#
# 这三个 app 在写这份 Dockerfile 时**还没有落地**（仓库里只有 apps/api 和 apps/client，
# T1 之后的任务才会补 admin/platform/site）。所以这里按 Vite + React 的标准产物形状
# （`vite build` → `dist/`，`index.html` 在根、带 hash 的资源在 `assets/` 下）来写，
# 一旦那三个 app 长出来，只要遵循这个约定，本文件不用改一行就能用。
#
# 用法：
#   docker build -f deploy/docker/Dockerfile.web --build-arg APP=admin \
#     --build-arg API_ORIGIN=https://api.{{rootDomain}} -t {{projectName}}-admin:local .
#   docker run --rm -p 8080:80 {{projectName}}-admin:local
#
# 产物落地规则（对应任务分解 T4-3 验收「前端产物带 hash 且 index.html 明确不缓存」）：
#   - index.html                 不缓存（nginx 侧 Cache-Control: no-cache，见 nginx/*.conf）
#   - assets/xxx-<hash>.js/.css  文件名带内容 hash，可以放心长缓存（一年 + immutable）
# 本 Dockerfile 只负责「产出这些文件、放进 nginx 镜像」；具体的缓存头在
# deploy/nginx/{admin,platform,site,client}.conf 里配，两处职责不重叠。
# ─────────────────────────────────────────────────────────────────────────────

ARG NODE_VERSION=22-alpine
ARG PNPM_VERSION=11.1.2
ARG NGINX_VERSION=1.27-alpine

# 选哪个 app：admin | platform | site（client 见文件头说明）
ARG APP=admin
# 该 app 的构建脚本名，标准 Vite app 是 `build`；Taro H5 是 `build:h5`
ARG BUILD_SCRIPT=build
# 前端在构建期需要知道 API 的源（同源反代场景下留空，见各 nginx 站点模板里的
# `location /api/`；只有跨域部署——比如 CDN 纯静态 + 独立 API 域名——才需要这个）
ARG API_ORIGIN=

# ── 阶段 1：pruner ───────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS pruner
ARG APP
WORKDIR /repo
RUN npm install -g turbo@2.10.12
COPY . .
RUN turbo prune @{{projectSlug}}/${APP} --docker
# 仓库根 pnpm-workspace.yaml 里 `msgpackr-extract` 那一行是没填完的占位值
# （字面量字符串，不是布尔值）；日常在完整仓库里跑 install 会短路成
# "Already up to date" 不触发，但 Docker 里每次都是全新安装，pnpm 11 会因为它把
# install 判失败（ERR_PNPM_IGNORED_BUILDS）。这里只改 pruner 产出的两份临时副本
# （out/json 给下面装依赖用，out/full 给编译用），不动仓库里的原文件。
RUN sed -i 's/^\(\s*msgpackr-extract:\).*/\1 true/' out/json/pnpm-workspace.yaml out/full/pnpm-workspace.yaml

# ── 阶段 2：builder ──────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS builder
ARG PNPM_VERSION
ARG APP
ARG BUILD_SCRIPT
ARG API_ORIGIN
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /repo
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ .
COPY --from=pruner /repo/turbo.json ./turbo.json
# Vite 的 `import.meta.env.VITE_*` 在构建期烤进产物；同源反代（默认，见 nginx 模板）
# 不需要这个变量，前端直接打相对路径 `/api/...`。只有独立域名部署才传它。
ENV VITE_API_ORIGIN=${API_ORIGIN}
RUN pnpm turbo run ${BUILD_SCRIPT} --filter=@{{projectSlug}}/${APP}...

# ── 阶段 3：runtime —— nginx 只端静态文件，不做反代（反代是宝塔/独立 nginx 层的事）──
FROM nginx:${NGINX_VERSION} AS runtime
ARG APP
# 容器内嵌一份最小 nginx 配置，只用于「本镜像自测」（docker run 直接看效果）；
# 生产环境走宝塔面板的 nginx，用 deploy/nginx/{admin,platform,site,client}.conf，
# 那份配置里有同源 /api/ 反代、SPA 回退、缓存头，本文件不重复。
COPY deploy/docker/web-selftest.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/apps/${APP}/dist /usr/share/nginx/html
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
EXPOSE 80
