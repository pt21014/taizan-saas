{
  "name": "create-taizan-saas",
  "version": "0.1.0",
  "type": "module",
  "description": "taizan-saas 项目生成器：pnpm create taizan-saas <name>，产出一个多租户 SaaS 骨架（api + admin + platform + site + client + app-*）",
  "license": "MIT",
  "keywords": [
    "taizan",
    "saas",
    "multi-tenant",
    "nestjs",
    "generator",
    "scaffold"
  ],
  "bin": {
    "create-taizan-saas": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build:templates": "tsx scripts/build-templates.ts",
    "build:templates:check": "tsx scripts/build-templates.ts --check"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@taizan/eslint-config": "workspace:*",
    "@taizan/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/prompts": "^2.4.9",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
