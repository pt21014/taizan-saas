{
  "name": "taizan-saas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "taizan-saas：多租户 SaaS 框架单仓（api + admin + platform + site + client + app-* 六端 + @taizan/* 核心包 + create-taizan-saas 生成器）",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "dev:infra": "docker compose -f deploy/docker/docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f deploy/docker/docker-compose.dev.yml down -v",
    "test:arch": "pnpm -F @taizan/api exec vitest run test/arch --reporter=verbose",
    "test:e2e": "pnpm -F @taizan/api test:e2e",
    "check:arch": "tsx scripts/check-arch.ts",
    "check:peer-deps": "tsx scripts/check-peer-deps.ts",
    "gen:module": "pnpm -F @taizan/codegen gen",
    "build:templates": "pnpm -F create-taizan-saas build:templates",
    "build:templates:check": "pnpm -F create-taizan-saas build:templates:check",
    "create:demo": "node scripts/create-demo.mjs",
    "acceptance": "bash scripts/acceptance.sh",
    "docs:error-codes": "node scripts/gen-error-codes.mjs",
    "license:sync": "node scripts/sync-license.mjs",
    "license:check": "node scripts/sync-license.mjs --check",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@taizan/prettier-config": "workspace:*",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "prettier": "@taizan/prettier-config"
}
