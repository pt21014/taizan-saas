# docker-compose.prod.yml 用的 .env.prod 模板。
#
# 这份**不是** apps/api/.env.example 的替代——它只补 docker-compose.prod.yml
# 自己需要、而 apps/api 的 zod schema 管不到的那几个变量（MySQL/Redis 的密码，
# compose 拼 DATABASE_URL/REDIS_URL 时要用）。真正跑起来还需要
# apps/api/.env.example 里列的全部业务变量（JWT 三把密钥、CRYPTO_KEYS…）——
# 把那份也抄过来接到同一个 .env.prod 里，两份内容合并成一份文件即可，
# api 服务的 `env_file` 会把整份都读进容器。
#
# 用法：
#   cp deploy/docker/.env.prod.example .env.prod
#   cat apps/api/.env.example | grep -v '^#' | grep '=' >> .env.prod   # 合并业务变量
#   # 然后把下面这几个占位改成真实值，再把合并进来的业务变量也填好
#   docker compose -f deploy/docker/docker-compose.prod.yml --env-file .env.prod up -d

# ── docker-compose.prod.yml 自己用的（拼 DATABASE_URL / REDIS_URL） ─────────
MYSQL_DATABASE=taizan
MYSQL_USER=taizan
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# ── nginx-compose.conf 对外端口（sudo 权限不够/端口已占用时改这个） ──────────
HTTP_PORT=80

# ── 镜像 tag（配合 deploy/scripts 的发布/回滚流程切版本用） ──────────────────
TAIZAN_IMAGE_TAG=local

# ── 以下变量清单来自 apps/api/.env.example，按需合并进来（不要手抄，那份是
#    由 src/config/env.ts 的 zod schema 自动生成的唯一真源，改动请改 schema
#    再重新生成）：
# NODE_ENV=production
# JWT_SECRET_PLATFORM=
# JWT_SECRET_STAFF=
# JWT_SECRET_MEMBER=
# CRYPTO_KEYS=
# CRYPTO_KEY_CURRENT=
# CORS_ORIGINS=
# ……完整清单见 apps/api/.env.example
