# ============================================================
# @taizan/api 环境变量（由 src/config/env.ts 的 zod schema 自动生成，请勿手改）
# 生成命令：pnpm taizan:env-example
# ============================================================

# 运行环境。production 会触发一系列安全硬检查（见 assertNoDevCodeInProd）
# [可选] [development | test | production]
NODE_ENV=development

# api 进程监听端口
# [可选] [number]
API_PORT=3000

# api 对外可访问的基址，用于拼接回调地址与 Swagger server
# [可选]
API_BASE_URL=http://localhost:3000

# MySQL 连接串，例：mysql://user:pass@127.0.0.1:3306/taizan
# [必填]
DATABASE_URL=

# Redis 连接串，例：redis://127.0.0.1:6379/0
# [必填]
REDIS_URL=

# 平台超管 token 签名密钥，≥32 位，必须与另两套不同
# [必填]
JWT_SECRET_PLATFORM=

# 商家员工 token 签名密钥，≥32 位，必须与另两套不同
# [必填]
JWT_SECRET_STAFF=

# C 端会员 token 签名密钥，≥32 位，必须与另两套不同
# [必填]
JWT_SECRET_MEMBER=

# 加密列密钥表，JSON：{"k1":"<64 hex>","k2":"<64 hex>"}。轮换时新增 keyId 而不是改旧值
# [必填] [JSON 对象]
CRYPTO_KEYS=

# 当前用于加密的 keyId，必须是 CRYPTO_KEYS 里已存在的键
# [必填]
CRYPTO_KEY_CURRENT=

# 允许跨域的 Origin 白名单，逗号分隔；支持 https://*.example.com 通配。生产环境留空会拒启
# [可选] [逗号分隔列表]
CORS_ORIGINS=

# 可信反代层数。resolveIps 从 X-Forwarded-For 末尾倒数这么多跳取真实客户端 IP，配错等于限流可被伪造绕过
# [可选] [number]
TRUSTED_PROXY_HOPS=1

# pino 日志级别
# [可选] [fatal | error | warn | info | debug | trace]
LOG_LEVEL=info

# 计费闸门总开关。false 时到期租户仍可写（只记 reason 并打 warn），打开之前先跑 deploy/checks/billing-check.sh 看谁会被锁
# [可选] [boolean（1/0、true/false）]
BILLING_ENFORCE=false

# 【危险·联调用】把短信验证码回传给调用方 = 任意手机号免验证登录。生产环境置真会拒启
# [可选] [boolean（1/0、true/false）]
SMS_RETURN_DEV_CODE=false

# 【危险·联调用】跳过微信 jscode2session 直接签发会员 token。生产环境置真会拒启
# [可选] [boolean（1/0、true/false）]
WECHAT_DEV_FAKE_LOGIN=false

# 是否开启 Swagger。非 production 默认开；production 只有显式置真才开（会暴露全部接口形状）
# [可选] [boolean（1/0、true/false）]
SWAGGER_ENABLED=false

# 本进程是否参与 @LeaderCron 调度。只跑 HTTP 的进程置 false，避免它抢到 leader 却缺依赖
# [可选] [boolean（1/0、true/false）]
CRON_ENABLED=true

# 本进程是否消费队列。false 时只入队不起 worker（web / worker 分开部署时用）
# [可选] [boolean（1/0、true/false）]
QUEUE_ENABLED=true

# 应用名，出现在 Swagger 标题与日志里
# [可选]
APP_NAME=taizan-saas

# C 端子域名解析的根域，例如 example.com（`shop-a.example.com` → slug `shop-a`）。本地不配即可，SubdomainResolver 会退化成不适用
# [可选]
TENANT_BASE_DOMAIN=

# 【危险·联调用】开启 POST /api/client/auth/login-dev：只给手机号就签发会员 token，不发短信不校验。生产环境置真会拒启
# [可选] [boolean（1/0、true/false）]
CLIENT_DEV_LOGIN=false

# 官网自助注册总开关（POST /api/public/signup、GET /api/public/signup/check-slug）。关掉之后接口仍在、仍限流，但一律回 1040000 —— 这是唯一「谁都能调且会往库里写」的入口，必须有一个不改代码、不改路由就能立刻关掉它的开关
# [可选] [boolean（1/0、true/false）]
SIGNUP_ENABLED=true

# 自助注册开出来的店试用几天（落到 Tenant.trialEndAt = 当天最后一刻）。0 表示「注册即到期」——那是一个可用的运营选择（先注册后付费），不是错误值
# [可选] [number]
SIGNUP_TRIAL_DAYS=14

# 试用到期未购买时自动挂上的免费套餐 code（`Plan.code`）。不配（默认）= 试用到期后保持 TRIAL 状态不动，由 `evaluateTenantGate` 现算打烊，续费白名单仍可写；配了 = `trial-convert` cron 通过 PlanOrderService 的统一 fulfill 路径把这些租户 0 元「续」到这档套餐上（见 `plan-lifecycle/trial-convert.cron.ts` 文件头）
# [可选]
SIGNUP_TRIAL_AUTO_PLAN=

# 【危险·联调用】给 PaymentModule 装 FakeProvider 并暴露 FakePaymentTestKit：带真 HMAC 签名的「假回调」可以直接兑现真权益（套餐续期）。e2e 与本地联调用，生产环境置真会拒启
# [可选] [boolean（1/0、true/false）]
PAY_FAKE_ENABLED=false

# ============================================================
# 本地 compose（deploy/docker/docker-compose.dev.yml）对应的取值：
#   DATABASE_URL=mysql://taizan:taizan_dev@127.0.0.1:3307/taizan_dev
#   REDIS_URL=redis://127.0.0.1:6380/0
# 端口刻意避开 3306/6379：这台机器上的老项目 compose 已经占了那两个。
#
# 三把 JWT 密钥各自 >=32 位且必须互不相同（loadEnv 的跨字段校验会拦）：
#   openssl rand -base64 48
# CRYPTO_KEYS 是 keyId -> 64 位 hex 的 JSON 映射，轮换时**新增 keyId**而不是改旧值：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================
