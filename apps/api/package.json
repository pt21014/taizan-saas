{
  "name": "@taizan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "taizan-saas 唯一后端进程：NestJS 11 模块化单体，三命名空间（/api/platform、/api/admin、/api/client）+ /api/public。装配 @taizan/* 全部框架包，示例业务模块 example-goods 贯穿七个扩展点。",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/bootstrap/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "pnpm run taizan:schema-sync && prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "retention": "tsx src/modules/platform/plan-lifecycle/retention.cli.ts",
    "taizan:schema-sync": "taizan-schema-sync prisma/schema",
    "taizan:schema-check": "taizan-schema-sync prisma/schema --check",
    "taizan:verify-schema": "taizan-verify-schema prisma/schema --registered=Goods,GoodsSku",
    "taizan:env-example": "tsx scripts/gen-env-example.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "@taizan/billing-rules": "workspace:*",
    "@taizan/contracts": "workspace:*",
    "@taizan/crypto": "workspace:*",
    "@taizan/nest-audit": "workspace:*",
    "@taizan/nest-auth": "workspace:*",
    "@taizan/nest-billing": "workspace:*",
    "@taizan/nest-core": "workspace:*",
    "@taizan/nest-infra": "workspace:*",
    "@taizan/nest-notify": "workspace:*",
    "@taizan/nest-payment": "workspace:*",
    "@taizan/nest-prisma": "workspace:*",
    "@taizan/nest-rbac": "workspace:*",
    "@taizan/payment-core": "workspace:*",
    "@taizan/prisma-base": "workspace:*",
    "@taizan/provision": "workspace:*",
    "@taizan/ratelimit-core": "workspace:*",
    "@taizan/rbac-core": "workspace:*",
    "@taizan/sms": "workspace:*",
    "@taizan/tenant-scope": "workspace:*",
    "@taizan/wechatpay": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@taizan/eslint-config": "workspace:*",
    "@taizan/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "@nestjs/testing": "^11.2.3"
  }
}
