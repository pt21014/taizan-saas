{
  "name": "@taizan/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "官网 + 自助注册（T3-5）：零 UI 库，11 页营销站 + 自助开店表单，接 apps/api 的 /api/public/* 真实接口。Vite 6 风格 + React 18 + react-router 6。",
  "scripts": {
    "generate": "tsx scripts/generate-tokens.ts",
    "dev": "pnpm run generate && vite",
    "build": "pnpm run generate && tsc --noEmit && vite build && tsx scripts/generate-seo.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "pretypecheck": "pnpm run generate",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run generate",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@taizan/contracts": "workspace:*",
    "@taizan/provision": "workspace:*",
    "@taizan/tokens": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@taizan/eslint-config": "workspace:*",
    "@taizan/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
