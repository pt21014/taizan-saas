# apps/site 的运行期配置。抄一份成 `.env.local`（Vite 约定，不进 git）。
#
# 本地开发留空即可：`vite.config.ts` 已经把 `/api` 代理到 `http://localhost:3000`，
# 生产部署与 API 同域（nginx 反代 `/api/`），同样不需要填。

# 商家后台地址（apps/admin 是与官网分开部署的另一个应用/子域名）。
# 注册成功页「去商家后台登录」按钮的 href 从这里取，见 src/config/BRAND.ts。
VITE_ADMIN_URL=

# ICP 备案号。没备案完成前留空，页脚会自动不渲染这一行。
VITE_ICP_NUMBER=

# 生成 sitemap.xml / robots.txt 时用的站点域名（不是 VITE_ 前缀，构建期读取，不进浏览器包）。
# 不配时退回一个占位域名，只影响搜索引擎收录，不影响构建产物是否存在。
SITE_ORIGIN=

# sitemap.xml 里每个 <url> 的 <lastmod>（YYYY-MM-DD，同样是构建期读取，不进浏览器包）。
# 不配时按 `git log -1 --format=%cI` 取最近一次提交时间，取不到（没装 git / 仓库还没有
# 任何提交）再回退到一个固定值——就是不能用「构建时的今天」：那会让同一次提交每天
# 构建出不同的 dist/sitemap.xml，与 dist/ 是构建产物这件事本身没关系，但会让依赖
# sitemap 内容做缓存/对账的流程失去确定性。发布流水线建议钉死成发布时间。
SITE_LASTMOD=
