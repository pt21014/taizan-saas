{
  "extends": "@taizan/tsconfig/react.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "scripts"]
}
